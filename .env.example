# ============================================
# Kiki en Christ - Variables d'environnement
# ============================================
# Copiez ce fichier vers .env.local pour le développement local
# Sur Vercel : ajoutez ces variables dans Project Settings > Environment Variables

# ------------------------------------------------------------------
# GA4 (Google Analytics 4) - Mesure d'audience
# ------------------------------------------------------------------
# ID de mesure GA4 (format: G-XXXXXXXXXX)
PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# ID GTM optionnel (si vous utilisez Google Tag Manager)
# PUBLIC_GTM_CONTAINER_ID="GTM-XXXXXXX"

# ------------------------------------------------------------------
# Consentement Cookies / RGPD
# ------------------------------------------------------------------
# Nom du cookie de consentement (ne changez pas)
PUBLIC_COOKIE_CONSENT_NAME="kikienchrist-consent"

# Durée de vie du consentement en jours (max 13 mois selon RGPD)
PUBLIC_CONSENT_MAX_AGE_DAYS="365"

# ------------------------------------------------------------------
# Newsletter (MailerLite / Netlify Functions)
# ------------------------------------------------------------------
# Clé publique MailerLite (pour formulaires côté client)
# PUBLIC_MAILERLITE_API_KEY="ml_xxxxxxxx"

# URL de la fonction Netlify pour l'inscription newsletter
# PUBLIC_NEWSLETTER_ENDPOINT="/.netlify/functions/newsletter-subscribe"

# ------------------------------------------------------------------
# Vercel Analytics / Speed Insights (déjà configuré via @vercel/analytics)
# ------------------------------------------------------------------
# Aucune variable nécessaire, activé automatiquement en production

# ------------------------------------------------------------------
# Monitoring d'erreurs (Sentry) - Optionnel
# ------------------------------------------------------------------
# PUBLIC_SENTRY_DSN="https://xxxx@sentry.io/xxxx"
# SENTRY_AUTH_TOKEN="xxxx" (côté serveur seulement)

# ------------------------------------------------------------------
# Paiements / E-commerce (Payhip, Lulu, etc.)
# ------------------------------------------------------------------
# Webhook secret Payhip (pour validation côté serveur)
# PAYHIP_WEBHOOK_SECRET="xxxx"

# ------------------------------------------------------------------
# Base de données / CMS (optionnel)
# ------------------------------------------------------------------
# DATABASE_URL="postgresql://..."
# DECAP_CMS_GITHUB_TOKEN="xxxx"