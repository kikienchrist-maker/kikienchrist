{
  "name": "schema-org-master",
  "version": "0.1.0",
  "description": "Schema.org JSON-LD Generator, Validator & Auditor for Maximum SEO",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./integrations/astro": {
      "import": "./dist/integrations/astro/index.js",
      "types": "./dist/integrations/astro/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "cli": "node --loader ts-node/esm src/cli/index.ts",
    "generate": "node --loader ts-node/esm src/cli/index.ts generate",
    "validate": "node --loader ts-node/esm src/cli/index.ts validate",
    "audit": "node --loader ts-node/esm src/cli/index.ts audit",
    "update-types": "node --loader ts-node/esm src/cli/index.ts update-types",
    "prepack": "npm run build"
  },
  "keywords": [
    "schema.org",
    "json-ld",
    "structured-data",
    "seo",
    "rich-results",
    "astro",
    "typescript",
    "builder-pattern"
  ],
  "author": "Kiki en Christ",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "zod": "^3.23.8",
    "schema-dts": "^1.1.2"
  },
  "devDependencies": {
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "ts-node": "^10.9.2",
    "eslint": "^9.10.0",
    "@types/node": "^22.7.0",
    "glob": "^11.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}