            "provider": { "type": "string", "enum": ["ollama", "libretranslate", "deepl"], "default": "ollama" },
            "model": { "type": "string", "default": "qwen2.5:1.5b" },
            "concurrency": { "type": "integer", "minimum": 1, "maximum": 10, "default": 2 },
            "dryRun": { "type": "boolean", "default": false },
            "outputDir": { "type": "string", "default": "src/content/blog" }
          },
          "required": []
        },
        "output": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "job": { "type": "object" },
                  "success": { "type": "boolean" },
                  "translatedFrontmatter": { "type": "object" },
                  "translatedBody": { "type": "string" },
                  "error": { "type": "string" },
                  "durationMs": { "type": "integer" },
                  "provider": { "type": "string" },
                  "model": { "type": "string" }
                },
                "required": ["job", "success", "durationMs", "provider"]
              }
            },
            "summary": {
              "type": "object",
              "properties": {
                "total": { "type": "integer" },
                "success": { "type": "integer" },
                "failed": { "type": "integer" },
                "totalDurationMs": { "type": "integer" },
                "byProvider": { "type": "object" },
                "byLang": { "type": "object" }
              },
              "required": ["total", "success", "failed", "totalDurationMs"]
            }
          },
          "required": ["results", "summary"]
        }
      },
      "dependencies": ["axios", "chalk", "commander", "ora", "p-limit", "yaml", "gray-matter", "@kikienchrist/markdown-sanitizer"],
      "devDependencies": ["vitest", "typescript", "@types/node"],
