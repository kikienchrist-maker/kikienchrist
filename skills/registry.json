    {
      "name": "seo-audit-fix",
      "version": "1.0.0",
      "description": "Audit SEO complet + auto-fix pour sites Astro statiques: Lighthouse, Meta tags, Schema.org, Hreflang, Contenu. Génère rapports HTML/JSON/Markdown + plan corrections.",
      "category": "core",
      "path": "skills/core/seo-audit-fix",
      "entry": "dist/index.js",
      "cli": "dist/cli.js",
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "baseUrl": { "type": "string", "format": "uri", "default": "https://kikienchrist.vercel.app" },
            "urls": { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "URLs spécifiques à auditer (optionnel, sinon sitemap + crawl)" },
            "runLighthouse": { "type": "boolean", "default": false },
            "lighthousePreset": { "type": "string", "enum": ["desktop", "mobile"], "default": "mobile" },
            "outputDir": { "type": "string", "default": "./seo-audit-report" },
            "thresholds": {
              "type": "object",
              "properties": {
                "performance": { "type": "integer", "minimum": 0, "maximum": 100, "default": 90 },
                "accessibility": { "type": "integer", "minimum": 0, "maximum": 100, "default": 95 },
                "bestPractices": { "type": "integer", "minimum": 0, "maximum": 100, "default": 90 },
                "seo": { "type": "integer", "minimum": 0, "maximum": 100, "default": 90 }
              },
              "default": { "performance": 90, "accessibility": 95, "bestPractices": 90, "seo": 90 }
            },
            "concurrency": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
            "excludePatterns": { "type": "array", "items": { "type": "string" }, "default": ["/404", "/admin", "/private"] }
          },
          "required": []
        },
        "output": {
          "type": "object",
          "properties": {
            "timestamp": { "type": "string", "format": "date-time" },
            "summary": {
              "type": "object",
              "properties": {
                "totalPages": { "type": "integer" },
                "auditedPages": { "type": "integer" },
                "failedPages": { "type": "integer" },
                "averageScore": { "type": "integer" },
                "pagesNeedingFix": { "type": "integer" },
                "lighthouseAverages": {
                  "type": "object",
                  "properties": {
                    "performance": { "type": "integer" },
                    "accessibility": { "type": "integer" },
                    "bestPractices": { "type": "integer" },
                    "seo": { "type": "integer" }
                  }
                }
              },
              "required": ["totalPages", "auditedPages", "averageScore"]
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": { "type": "string" },
                  "lang": { "type": "string" },
                  "score": { "type": "integer" },
                  "issues": { "type": "array" },
                  "fixes": { "type": "array" }
                }
              }
            }
          },
          "required": ["timestamp", "summary", "pages"]
        }
      },
      "dependencies": ["axios", "chalk", "commander", "jsdom", "ora", "p-limit", "lighthouse"],
      "devDependencies": ["vitest", "typescript", "@types/node", "@types/jsdom"],
      "tags": ["seo", "audit", "lighthouse", "meta", "schema-org", "hreflang", "astro", "static-site", "ci-cd"],
