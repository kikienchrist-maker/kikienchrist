    {
      "name": "markdown-sanitizer",
      "version": "1.0.0",
      "description": "Nettoie, valide et corrige les fichiers Markdown + frontmatter YAML (slugs, types, encoding, tags, collections Astro)",
      "category": "utils",
      "path": "skills/markdown-sanitizer",
      "entry": "dist/index.js",
      "cli": "dist/cli.js",
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "content": { "type": "string", "description": "Contenu Markdown brut" },
            "options": {
              "type": "object",
              "properties": {
                "collection": { "type": "string", "enum": ["blog", "legal", "book", "auto"] },
                "sourceLang": { "type": "string", "enum": ["fr", "en", "es", "pt", "it", "de", "nl", "pl", "ar", "ru", "zh", "hi"] },
                "knownBaseSlugs": { "type": "array", "items": { "type": "string" } },
                "autoFix": { "type": "boolean", "default": true },
                "dryRun": { "type": "boolean", "default": false }
              },
              "required": []
            }
          },
          "required": ["content"]
        },
        "output": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "content": { "type": "string", "description": "Markdown corrigé" },
            "frontmatter": { "type": "object", "description": "Frontmatter validé et typé" },
            "errors": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "fixes": { "type": "array", "items": { "type": "string" } },
            "collection": { "type": "string", "enum": ["blog", "legal", "book", "unknown"] },
            "baseSlug": { "type": "string" },
            "lang": { "type": "string" }
          },
          "required": ["success", "content", "frontmatter"]
        }
      },
      "dependencies": ["gray-matter", "js-yaml", "slugify", "zod", "commander"],
      "devDependencies": ["vitest", "typescript", "@types/js-yaml", "@types/node"],
      "tags": ["markdown", "frontmatter", "yaml", "sanitizer", "astro", "i18n", "validation"],
      "status": "ready",
      "created": "2026-11-24",
      "testCoverage": { "lines": 80, "functions": 80, "branches": 70, "statements": 80 }
    },
    {
      "name": "blog-translation",
      "version": "1.0.0",
      "description": "Pipeline de traduction d'articles blog multilingues (Ollama, LibreTranslate, DeepL) avec glossaire contextuel, fallback auto, validation et reprise",
