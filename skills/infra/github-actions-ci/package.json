{
  "name": "@kikienchrist/github-actions-ci",
  "version": "1.0.0",
  "description": "Générateur pipeline GitHub Actions CI/CD: lint, typecheck, unit, build, e2e, a11y, lighthouse, security, deploy preview/production",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gha-ci": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "cli": "node dist/cli.js"
  },
  "keywords": ["github-actions", "ci-cd", "astro", "vercel", "playwright", "lighthouse", "accessibility", "security"],
  "author": "Kiki en Christ",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}