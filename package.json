{
  "name": "kikienchrist-vercel-sync",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "lint": "eslint . --ext .astro,.ts,.js",
    "lint:fix": "eslint . --ext .astro,.ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --project=chromium-a11y",
    "deploy": "npm run build && vercel --prod --force",
    "deploy:preview": "npm run build && vercel",
    "migrate:images": "tsx scripts/migrate-images.ts",
    "update:images": "tsx scripts/update-translations-images.ts",
    "generate:pwa-icons": "tsx scripts/generate-pwa-icons.ts",
    "prepare": "husky install",
    "commitlint": "commitlint --edit",
    "lint-staged": "lint-staged",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^4.16.0",
    "googleapis": "^190.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.1",
    "marked-gfm-heading-id": "^4.1.4",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "workbox-window": "^7.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@netlify/functions": "^2.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^8.56.0",
    "eslint-plugin-astro": "^1.0.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.2.0",
    "prettier-plugin-astro": "^0.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^1.3.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "semantic-release": "^24.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "^12.0.0",
    "@semantic-release/release-notes-generator": "^6.0.0",
    "conventional-changelog-cli": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
