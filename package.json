{
  "name": "kikienchrist-vercel-sync",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "lint": "eslint . --ext .astro,.ts,.js",
    "lint:fix": "eslint . --ext .astro,.ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --project=chromium-a11y",
    "deploy": "npm run build && vercel --prod --force",
    "deploy:preview": "npm run build && vercel"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.1",
    "marked-gfm-heading-id": "^4.1.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@netlify/functions": "^2.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "eslint": "^8.56.0",
    "eslint-plugin-astro": "^1.0.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.2.0",
    "prettier-plugin-astro": "^0.13.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
