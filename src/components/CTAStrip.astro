---
// CTAStrip.astro — Localized version

interface Props {
  text?: string;
  buttonText?: string;
  buttonHref?: string;
}

const ctaText = Astro.props.text ?? "Prêt à commencer votre chemin ? Choisissez le livre qui résonne — le premier pas change tout.";
const ctaButtonText = Astro.props.buttonText ?? "Voir les 4 livres";
const ctaButtonHref = Astro.props.buttonHref ?? "#livres";
---

<div class="cta-strip">
  <div class="wrap">
    <p>{ctaText}</p>
    <a class="btn" href={ctaButtonHref}>{ctaButtonText}</a>
  </div>
</div>

<style is:global>
  .cta-strip {
    margin: 0;
    padding: 32px 0;
    background: var(--ink);
    color: #efe6d6;
    position: relative;
    overflow: hidden;
  }
  .cta-strip::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(70% 160% at 12% 0%, rgba(168,131,74,.34), transparent 62%);
  }
  .cta-strip .wrap {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 18px 30px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .cta-strip p {
    margin: 0;
    font: 500 15.5px/1.55 system-ui, sans-serif;
    color: #e9dfcd;
    max-width: 640px;
  }
  .cta-strip a.btn {
    background: var(--gold);
    color: #191713;
    padding: 15px 28px;
    border-radius: 6px;
    text-decoration: none;
    font: 700 14px/1 system-ui, sans-serif;
    letter-spacing: .03em;
    white-space: nowrap;
    box-shadow: 0 5px 16px rgba(0,0,0,.3);
  }
  .cta-strip a.btn:hover {
    background: var(--gold-soft);
    transform: translateY(-2px);
  }
  @media (max-width: 640px) {
    .cta-strip .wrap { flex-direction: column; }
  }
</style>