---
// CTAStrip.astro — Localized version (lafoidieu .bq classes)

interface Props {
  text?: string;
  buttonText?: string;
  buttonHref?: string;
}

const ctaText = Astro.props.text ?? "Prêt à commencer votre chemin ? Choisissez le livre qui résonne — le premier pas change tout.";
const ctaButtonText = Astro.props.buttonText ?? "Voir les 4 livres";
const ctaButtonHref = Astro.props.buttonHref ?? "#livres";
---

<div class="bq-cta-strip">
  <div class="bq-container">
    <p class="bq-cta-text">{ctaText}</p>
    <a class="bq-btn bq-btn-primary bq-btn-lg" href={ctaButtonHref}>{ctaButtonText}</a>
  </div>
</div>

<style is:global>
  .bq-cta-strip {
    margin: 0;
    padding: 32px 0;
    background: var(--ink);
    color: var(--cream);
    position: relative;
    overflow: hidden;
  }
  .bq-cta-strip::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(70% 160% at 12% 0%, rgba(168,131,74,.34), transparent 62%);
  }
  .bq-cta-strip .bq-container {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 18px 30px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .bq-cta-text {
    margin: 0;
    font: 500 15.5px/1.55 system-ui, sans-serif;
    color: var(--cream);
    max-width: 640px;
  }
</style>