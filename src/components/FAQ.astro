---
// FAQ.astro — Localized version (lafoidieu .bq classes)

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FAQItem[];
}

const faqTitle = Astro.props.title ?? "Questions fréquentes";
const faqItems = Astro.props.items;
---

<div class="bq-faq" id="faq">
  <h2 class="bq-section-title">{faqTitle}</h2>
  <div class="bq-faq-list">
    {faqItems.map(({ question, answer }) => (
      <details class="bq-faq-item">
        <summary class="bq-faq-question">{question}</summary>
        <div class="bq-faq-answer">
          <p>{answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>

<style is:global>
  .bq-faq {
    width: calc(100% - 48px);
    max-width: 1092px;
    margin: clamp(44px, 6vw, 76px) auto;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3.4vw, 40px) clamp(22px, 3.6vw, 44px) clamp(6px, 1vw, 12px);
    box-shadow: var(--shadow-lg);
  }
  .bq-faq-list { display: flex; flex-direction: column; gap: 0; }
  .bq-faq-item { border-bottom: 1px solid var(--line); padding: 0; }
  .bq-faq-item:first-of-type { border-top: 0; }
  .bq-faq-question {
    font: 600 16.5px/1.45 Georgia, serif;
    padding: 20px 0;
    color: var(--ink);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    cursor: pointer;
  }
  .bq-faq-question::-webkit-details-marker { display: none; }
  .bq-faq-question::after {
    content: "+";
    flex: 0 0 auto;
    font: 400 21px/1 system-ui, sans-serif;
    color: var(--gold-ink);
    transition: transform var(--transition-fast);
  }
  .bq-faq-item[open] .bq-faq-question::after { content: "−"; transform: rotate(180deg); }
  .bq-faq-answer { padding: 0 0 20px; }
  .bq-faq-answer p { margin: 0; color: var(--muted); }
  .bq-faq-item:last-of-type .bq-faq-answer { margin-bottom: 0; }
</style>