---
// FAQ.astro — Localized version

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FAQItem[];
}

const faqTitle = Astro.props.title ?? "Questions fréquentes";
const faqItems = Astro.props.items;

// Pre-render FAQ items to avoid template scoping issues
const faqHtml = faqItems.map(({ question, answer }) => `
  <details>
    <summary>${question}</summary>
    <p>${answer}</p>
  </details>
`).join('');
---

<div class="faq" id="faq">
  <h2>{faqTitle}</h2>
  <div set:html={faqHtml} />
</div>

<style is:global>
  .faq {
    width: calc(100% - 48px);
    max-width: 1092px;
    margin: clamp(44px, 6vw, 76px) auto;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(22px, 3.4vw, 40px) clamp(22px, 3.6vw, 44px) clamp(6px, 1vw, 12px);
    box-shadow: 0 22px 48px -34px rgba(28,26,23,.38);
  }
  .faq h2 { margin-bottom: 8px; }
  .faq details { border-bottom: 1px solid var(--line); padding: 0; }
  .faq details:first-of-type { border-top: 0; }
  .faq summary {
    font: 600 16.5px/1.45 Georgia, serif;
    padding: 20px 0;
    color: var(--ink);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    cursor: pointer;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: "+";
    flex: 0 0 auto;
    font: 400 21px/1 system-ui, sans-serif;
    color: var(--gold-ink);
    transition: transform .2s;
  }
  .faq details[open] summary::after { content: "−"; transform: rotate(180deg); }
  .faq p { margin: 0 0 20px; color: #3d3830; }
  .faq details:last-of-type p { margin-bottom: 0; }
</style>