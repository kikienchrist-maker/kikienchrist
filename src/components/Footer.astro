---
// Footer.astro — Localized version with inline language switcher + legal links (lafoidieu .bq classes)

import fs from 'fs';
import path from 'path';
import type { Lang } from '../data/translations.json';

const translations = JSON.parse(fs.readFileSync(path.resolve('./src/data/translations.json'), 'utf-8'));

interface NavItem {
  label: string;
  href: string;
}

interface SocialItem {
  label: string;
  href: string;
  external: boolean;
}

interface LegalNavItem {
  label: string;
  href: string;
  slug: string;
}

interface Props {
  nav?: NavItem[];
  social?: SocialItem[];
  legalNav?: LegalNavItem[];
  availability?: string;
  copyright?: string;
  locale?: string;
  lang?: Lang;
  currentPath?: string;
}

const { lang = 'fr', currentPath = '/' } = Astro.props;
const t = translations[lang] || translations.fr;
const currentLang = lang;

const nav = Astro.props.nav ?? [
  { label: t.common?.home || "Accueil", href: `/${currentLang}/` },
  { label: t.common?.books || "Livres", href: `/${currentLang}/#livres` },
  { label: t.common?.blog || "Blog", href: `/${currentLang}/blog/` },
  { label: t.common?.guides || "Guides", href: `/${currentLang}/guides/` },
  { label: t.common?.freeGuide || "Guide offert", href: `/${currentLang}/7-prieres/` }
];

const social = Astro.props.social ?? [
  { label: "Instagram", href: "https://www.instagram.com/kikienchrist1/", external: true },
  { label: "Pinterest", href: "https://fr.pinterest.com/kikienchrist/", external: true }
];

const legalSlugs = ['mentions-legales', 'confidentialite', 'cookies', 'cgv', 'accessibilite'] as const;
const defaultLegalNav: LegalNavItem[] = legalSlugs.map(slug => ({
  label: t.legal?.nav?.[slug] || slug,
  href: `/${currentLang}/${slug}/`,
  slug
}));
const legalNav = Astro.props.legalNav ?? defaultLegalNav;

const availability = Astro.props.availability ?? (t.footer?.availability ?? "Livres disponibles en papier, ebook et audio.");
const copyright = Astro.props.copyright ?? (t.footer?.copyright ?? "Kiki en Christ. Tous droits réservés.");
const currentYear = new Date().getFullYear();
---

<footer class="bq-footer" role="contentinfo">
  <div class="bq-container">
    <div class="bq-footer-grid">
      <nav class="bq-footer-nav" aria-label={t.footer?.mainNav || 'Navigation principale'}>
        <h3 class="bq-footer-title">{t.footer?.site || 'Le site'}</h3>
        <ul class="bq-footer-list">
          {nav.map((item) => (
            <li><a href={item.href} class="bq-footer-link">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="bq-footer-nav" aria-label={t.footer?.legalNav || 'Mentions légales'}>
        <h3 class="bq-footer-title">{t.footer?.legal || 'Mentions légales'}</h3>
        <ul class="bq-footer-list">
          {legalNav.map((item) => (
            <li><a href={item.href} class="bq-footer-link">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="bq-footer-brand">
        <a href={`/${currentLang}/`} class="bq-footer-logo">
          <svg class="bq-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="2"/>
            <path d="M10 16l4 4 8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Kiki en Christ</span>
        </a>
        <p class="bq-footer-tagline">{t.footer?.tagline || 'Priez, méditez, grandissez dans la foi'}</p>
      </div>

      <div class="bq-footer-newsletter">
        <h3 class="bq-footer-title">{t.footer?.newsletter || 'Newsletter'}</h3>
        <p class="bq-footer-text">{t.footer?.newsletterDesc || 'Recevez nos prières et méditations hebdomadaires'}</p>
        <form class="bq-form-row" action="https://formspree.io/f/your-form-id" method="POST">
          <div class="bq-form-group">
            <label for="footer-email">{t.footer?.emailLabel || 'Email'}</label>
            <input type="email" id="footer-email" name="email" class="bq-input" placeholder={t.footer?.emailPlaceholder || 'votre@email.com'} required />
          </div>
          <button type="submit" class="bq-btn bq-btn-primary bq-btn-sm bq-btn-full">{t.footer?.subscribe || 'S\'abonner'}</button>
        </form>
      </div>
    </div>

    <div class="bq-footer-bottom">
      <p class="bq-copyright">© {currentYear} Kiki en Christ. {t.footer?.allRights || 'Tous droits réservés.'}</p>
      <div class="bq-social-links">
        <a href="https://www.facebook.com/kikienchrist" class="bq-social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.instagram.com/kikienchrist" class="bq-social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://twitter.com/kikienchrist" class="bq-social-link" aria-label="Twitter" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
        </a>
        <a href="https://www.youtube.com/@kikienchrist" class="bq-social-link" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>