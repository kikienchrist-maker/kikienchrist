---
// Hero.astro — Hero section with overlapped book fan (lafoidieu design system .bq classes)

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
  fanImages?: string[];
  fanAltTexts?: string[];
}

const {
  eyebrow = "Nouveauté",
  title,
  subtitle,
  ctaText = "Recevez « 7 prières » gratuitement — Un verset, une méditation, un encouragement chaque semaine",
  ctaHref = "/fr/contact",
  fanImages = [
    "https://assets.lulu.com/cover_thumbs/z/6/z6gg2r-front-shortedge-384.jpg",
    "https://assets.lulu.com/cover_thumbs/n/k/nk9wg4-front-shortedge-384.jpg",
    "https://assets.lulu.com/cover_thumbs/7/k/7kgm227-front-shortedge-384.jpg",
    "https://assets.lulu.com/cover_thumbs/n/v/nvg4d9k-front-shortedge-384.jpg"
  ],
  fanAltTexts = [
    "Le visage de Dieu : la quête de la spiritualité et de la transcendance",
    "Les secrets de la Trinité enfin dévoilés",
    "Le dernier Combat : garder la Foi",
    "Le mystère du Salut"
  ]
} = Astro.props;

const showFan = fanImages.length === 4 && fanImages.length === fanAltTexts.length;
---

<section class="bq-hero" aria-labelledby="hero-title">
  <div class="bq-container">
    <header class="bq-hero-header">
      {eyebrow && <span class="bq-eyebrow">{eyebrow}</span>}
      <h1 id="hero-title" class="bq-hero-title">{title}</h1>
      <p class="bq-hero-subtitle">{subtitle}</p>
    </header>

    <div class="bq-hero-ctas">
      <a href={ctaHref} class="bq-btn bq-btn-primary bq-btn-lg">{ctaText}</a>
    </div>

    {showFan && (
      <div class="bq-hero-fan" aria-label="Nos 4 livres" role="list">
        {fanImages.map((src, i) => (
          <img
            class={`bq-hero-fan-img bq-hero-fan-img--${i}`}
            src={src}
            alt={fanAltTexts[i] || `Livre ${i + 1}`}
            loading={i === 0 ? "eager" : "lazy"}
          />
        ))}
      </div>
    )}
  </div>
</section>

<style is:global>
  /* Hero standalone .bq-* classes */
  .bq-hero {
    max-width: none;
    position: relative;
    padding: 0;
    text-align: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    background:
      radial-gradient(90% 130% at 50% -40%, #fff 0%, rgba(255,255,255,0) 58%),
      linear-gradient(180deg, #fffdf9 0%, #f8f2e7 100%);
  }
  .bq-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .5;
    background-image: radial-gradient(rgba(28,26,23,.07) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .bq-hero .bq-container {
    position: relative;
    z-index: 1;
    padding-top: clamp(52px, 7.5vw, 92px);
    padding-bottom: clamp(44px, 6.5vw, 74px);
  }
  .bq-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: nowrap;
    font: 600 11.5px/1 system-ui, sans-serif;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--gold-ink);
    margin: 0 0 24px;
  }
  .bq-eyebrow::before,
  .bq-eyebrow::after {
    content: "";
    height: 1px;
    width: clamp(22px, 6vw, 56px);
    flex: 0 0 auto;
  }
  .bq-eyebrow::before { background: linear-gradient(90deg, transparent, var(--gold)); }
  .bq-eyebrow::after { background: linear-gradient(90deg, var(--gold), transparent); }

  .bq-hero-title {
    font-size: clamp(31px, 5.2vw, 58px);
    line-height: 1.07;
    letter-spacing: -.022em;
    font-weight: 400;
    margin: 0 auto 24px;
    max-width: 760px;
    font-family: Georgia, 'Times New Roman', serif;
    color: var(--ink);
  }
  .bq-hero-subtitle {
    font-size: clamp(18px, 2.5vw, 22px);
    line-height: 1.5;
    color: var(--muted);
    margin: 0 auto 32px;
    max-width: 600px;
    font-family: Georgia, 'Times New Roman', serif;
  }
  .bq-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  /* ===== OVERLAPPED BOOK FAN (Deck de cartes - superposé gauche→droite) ===== */
  .bq-hero-fan {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(-60px, -8vw, -40px); /* NÉGATIF = superposition */
    max-width: 900px;
    margin: 0 auto;
    padding-bottom: clamp(20px, 3vw, 40px);
    position: relative;
  }

  .bq-hero-fan-img {
    width: clamp(140px, 17vw, 200px);
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow:
      0 20px 40px rgba(28,26,23,.25),
      0 8px 16px rgba(28,26,23,.15),
      0 0 0 1px var(--line);
    border: 1px solid var(--line);
    background: var(--paper);
    cursor: pointer;
    transition:
      transform 0.5s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.4s ease,
      z-index 0.1s;
    will-change: transform, box-shadow, z-index;
    flex-shrink: 0;
  }

  /* Positions de base : léger échelonnement Y + rotation perspective */
  .bq-hero-fan-img--0 { transform: translateY(0) rotateY(6deg) rotateZ(-1.5deg); z-index: 4; }
  .bq-hero-fan-img--1 { transform: translateY(-8px) rotateY(2deg) rotateZ(-0.5deg); z-index: 3; }
  .bq-hero-fan-img--2 { transform: translateY(-16px) rotateY(-2deg) rotateZ(0.5deg); z-index: 2; }
  .bq-hero-fan-img--3 { transform: translateY(-24px) rotateY(-6deg) rotateZ(1.5deg); z-index: 1; }

  /* Hover: livre pop vers le haut + agrandit + z-index max */
  .bq-hero-fan-img:hover,
  .bq-hero-fan-img:focus {
    transform:
      translateY(-clamp(48px, 6vw, 72px))
      rotateY(0deg)
      rotateZ(0deg)
      scale(1.12) !important;
    z-index: 50 !important;
    box-shadow:
      0 48px 96px rgba(28,26,23,.4),
      0 20px 40px rgba(28,26,23,.3),
      0 0 0 3px var(--gold) !important;
  }

  /* Focus visible pour accessibilité */
  .bq-hero-fan-img:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 4px;
  }

  /* Entrance animation - stagger gauche→droite */
  @keyframes fan-slide-up {
    from {
      opacity: 0;
      transform: translateY(40px) rotateY(10deg) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateY(var(--final-y, 0)) rotateY(var(--final-ry, 0deg)) scale(1);
    }
  }

  .bq-hero-fan-img--0 {
    animation: fan-slide-up 0.7s cubic-bezier(0.23, 1, 0.32, 1) backwards;
    --final-y: 0;
    --final-ry: 6deg;
  }
  .bq-hero-fan-img--1 {
    animation: fan-slide-up 0.7s cubic-bezier(0.23, 1, 0.32, 1) 0.08s backwards;
    --final-y: -8px;
    --final-ry: 2deg;
  }
  .bq-hero-fan-img--2 {
    animation: fan-slide-up 0.7s cubic-bezier(0.23, 1, 0.32, 1) 0.16s backwards;
    --final-y: -16px;
    --final-ry: -2deg;
  }
  .bq-hero-fan-img--3 {
    animation: fan-slide-up 0.7s cubic-bezier(0.23, 1, 0.32, 1) 0.24s backwards;
    --final-y: -24px;
    --final-ry: -6deg;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bq-hero-fan-img { animation: none; transition: none; }
    .bq-hero-fan-img:hover { transform: none; }
  }

  /* Mobile: stack vertical avec léger éventail */
  @media (max-width: 640px) {
    .bq-hero-fan {
      flex-direction: column;
      align-items: center;
      gap: clamp(-40px, -6vw, -24px);
      padding-bottom: clamp(16px, 4vw, 24px);
    }
    .bq-hero-fan-img {
      width: clamp(130px, 35vw, 180px);
    }
    .bq-hero-fan-img--0 { transform: translateY(0) rotateY(4deg) rotateZ(-1deg); }
    .bq-hero-fan-img--1 { transform: translateY(-6px) rotateY(1.5deg) rotateZ(-0.3deg); }
    .bq-hero-fan-img--2 { transform: translateY(-12px) rotateY(-1.5deg) rotateZ(0.3deg); }
    .bq-hero-fan-img--3 { transform: translateY(-18px) rotateY(-4deg) rotateZ(1deg); }
    .bq-hero-fan-img:hover {
      transform:
        translateY(-clamp(32px, 4vw, 48px))
        rotateY(0deg)
        rotateZ(0deg)
        scale(1.1) !important;
    }
  }
</style>