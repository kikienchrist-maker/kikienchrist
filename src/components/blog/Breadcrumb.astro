---
// Breadcrumb.astro - Fil d'Ariane avec JSON-LD BreadcrumbList (lafoidieu .bq classes)
interface Props {
  items: Array<{
    label: string;
    href?: string;
    current?: boolean;
  }>;
}

const { items } = Astro.props;

// Générer JSON-LD BreadcrumbList
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.href ? new URL(item.href, Astro.site).toString() : undefined,
  })).filter(item => item.item),
};
---

<nav class="bq-breadcrumb" aria-label="Fil d'Ariane" itemscope itemtype="https://schema.org/BreadcrumbList">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  
  <ol class="bq-breadcrumb-list" role="list">
    {items.map((item, index) => (
      <li 
        class="bq-breadcrumb-item" 
        itemprop="itemListElement" 
        itemscope 
        itemtype="https://schema.org/ListItem"
        key={index}
      >
        <meta itemprop="position" content={index + 1} />
        
        {item.href ? (
          <a 
            href={item.href} 
            itemprop="item"
            class="bq-breadcrumb-link"
            aria-current={item.current ? 'page' : undefined}
          >
            <span itemprop="name">{item.label}</span>
          </a>
        ) : (
          <span 
            itemprop="name" 
            class="bq-breadcrumb-current"
            aria-current="page"
          >
            {item.label}
          </span>
        )}
        
        {index < items.length - 1 && (
          <span class="bq-breadcrumb-separator" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style is:global>
  .bq-breadcrumb { margin-bottom: var(--space-lg); font-size: var(--text-sm); }
  .bq-breadcrumb-list { display: flex; flex-wrap: wrap; align-items: center; list-style: none; margin: 0; padding: 0; gap: var(--space-xs); color: var(--muted); }
  .bq-breadcrumb-item { display: flex; align-items: center; }
  .bq-breadcrumb-link { color: var(--muted); text-decoration: none; transition: color var(--transition-fast); }
  .bq-breadcrumb-link:hover { color: var(--gold-ink); }
  .bq-breadcrumb-current { color: var(--ink); font-weight: 500; }
  .bq-breadcrumb-separator { color: var(--line); flex-shrink: 0; }
</style>