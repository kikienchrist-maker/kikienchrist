---
// Pagination.astro - Pagination accessible avec ellipsis (lafoidieu .bq classes)
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  lang?: string;
  previousText?: string;
  nextText?: string;
  pageOfText?: string;
}

const { 
  currentPage, 
  totalPages, 
  baseUrl, 
  lang = 'fr',
  previousText = 'Précédent',
  nextText = 'Suivant',
  pageOfText = 'Page {current} sur {total}',
} = Astro.props;

function getPageNumbers(current: number, total: number): (number | 'ellipsis')[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }
  
  const pages: (number | 'ellipsis')[] = [1];
  
  if (current > 3) {
    pages.push('ellipsis');
    pages.push(current - 1, current, current + 1);
  } else {
    pages.push(2, 3, 4);
  }
  
  if (current < total - 2) {
    if (current > 3) {
      // already added current+1
    } else {
      pages.push(current + 1);
    }
    pages.push('ellipsis');
    pages.push(total);
  } else {
    for (let i = Math.max(current + 2, (pages[pages.length - 1] as number) + 1); i <= total; i++) {
      pages.push(i);
    }
  }
  
  return pages.filter((p, i, arr) => {
    if (p === 'ellipsis') return arr[i - 1] !== 'ellipsis';
    return true;
  });
}

const pageNumbers = getPageNumbers(currentPage, totalPages);
---

<nav class="bq-pagination" aria-label="Pagination des articles" role="navigation">
  <span class="bq-pagination-info" aria-live="polite">
    {pageOfText.replace('{current}', String(currentPage)).replace('{total}', String(totalPages))}
  </span>
  
  <ul class="bq-pagination-list" role="list">
    {/* Previous */}
    <li>
      <a 
        href={currentPage > 1 ? `${baseUrl}page/${currentPage - 1}/` : '#'} 
        class="bq-pagination-link bq-pagination-prev"
        aria-label={previousText}
        aria-disabled={currentPage === 1}
        rel={currentPage === 1 ? 'nofollow' : undefined}
        tabindex={currentPage === 1 ? -1 : undefined}
        aria-hidden={currentPage === 1}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span class="bq-pagination-link-text">{previousText}</span>
      </a>
    </li>
    
    {/* Page numbers */}
    {pageNumbers.map(page => (
      page === 'ellipsis' ? (
        <li class="bq-pagination-ellipsis" aria-hidden="true"><span>…</span></li>
      ) : (
        <li>
          <a 
            href={page === currentPage ? '#' : `${baseUrl}page/${page}/`}
            class="bq-pagination-link" 
            aria-label={`Page ${page}`}
            aria-current={page === currentPage ? 'page' : undefined}
            aria-disabled={page === currentPage}
            tabindex={page === currentPage ? -1 : undefined}
          >
            {page}
          </a>
        </li>
      )
    ))}
    
    {/* Next */}
    <li>
      <a 
        href={currentPage < totalPages ? `${baseUrl}page/${currentPage + 1}/` : '#'} 
        class="bq-pagination-link bq-pagination-next"
        aria-label={nextText}
        aria-disabled={currentPage === totalPages}
        rel={currentPage === totalPages ? 'nofollow' : undefined}
        tabindex={currentPage === totalPages ? -1 : undefined}
        aria-hidden={currentPage === totalPages}
      >
        <span class="bq-pagination-link-text">{nextText}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </li>
  </ul>
</nav>

<style is:global>
  .bq-pagination { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-md); margin: var(--space-xl) 0; }
  .bq-pagination-info { font-size: var(--text-sm); color: var(--muted); font-family: Georgia, serif; white-space: nowrap; }
  .bq-pagination-list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs); list-style: none; margin: 0; padding: 0; }
  .bq-pagination-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-width: 40px;
    height: 40px;
    padding: 0 var(--space-sm);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    transition: all var(--transition-fast);
  }
  .bq-pagination-link:hover:not([aria-disabled="true"]) { background: var(--gold-soft); border-color: var(--gold); color: var(--gold-ink); }
  .bq-pagination-link[aria-current="page"] { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .bq-pagination-link[aria-disabled="true"] { opacity: 0.4; pointer-events: none; }
  .bq-pagination-prev .bq-pagination-link-text,
  .bq-pagination-next .bq-pagination-link-text { display: none; }
  @media (min-width: 480px) {
    .bq-pagination-prev .bq-pagination-link-text,
    .bq-pagination-next .bq-pagination-link-text { display: inline; }
  }
  .bq-pagination-ellipsis { color: var(--muted); padding: 0 var(--space-sm); }
</style>