---
// BlogPost.astro - Article complet unifié (design system lafoidieu .bq)
import type { CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import NewsletterForm from '../NewsletterForm.astro';
import RelatedPosts from './RelatedPosts.astro';
import SocialShare from '../SocialShare.astro';
import TableOfContents from './TableOfContents.astro';
import ReadingProgress from './ReadingProgress.astro';
import Breadcrumb from '../Breadcrumb.astro';
import { generateBlogPostingJsonLd, generateArticleMetaTags, getCategoryLabel } from '../../utils/blog';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { data, body, slug } = entry;
const siteUrl = Astro.site?.toString() || 'https://kikienchrist.vercel.app';

function slugify(str: string): string {
  return str
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

const parseDate = (dateStr: string) => {
  try {
    const d = new Date(dateStr);
    return isNaN(d.getTime()) ? null : d;
  } catch {
    return null;
  }
};

const jsonLd = generateBlogPostingJsonLd(entry as any, siteUrl);
const metaTags = generateArticleMetaTags(entry as any, siteUrl);
const canonical = metaTags.canonical;
const ogTitle = metaTags['og:title'];
const ogDescription = metaTags['og:description'];
const ogImage = metaTags['og:image'];
const noindex = data.noindex;
const nofollow = data.nofollow;

const readingTime = data.readingTime || Math.ceil((body?.split(/\s+/).length || 0) / 200);
const catLabel = getCategoryLabel(data.category, data.lang);

const formatDate = (dateStr: string, lang: string) => {
  const d = parseDate(dateStr);
  if (!d) return dateStr;
  try {
    const supportedLocales = ['fr', 'en', 'es', 'pt', 'it', 'de', 'nl', 'pl'];
    const locale = supportedLocales.includes(lang) ? lang : 'en';
    return d.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' });
  } catch {
    return dateStr;
  }
};

const breadcrumbItems = [
  { label: 'Accueil', href: `/${data.lang}/` },
  { label: 'Blog', href: `/${data.lang}/blog/1` },
  { label: catLabel, href: `/${data.lang}/blog/categorie/${data.category}/1` },
];
---

<MainLayout
  title={data.title}
  description={data.description}
  lang={data.lang}
  canonicalURL={canonical}
  noindex={noindex}
  nofollow={nofollow}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  twitterCard="summary_large_image"
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <ReadingProgress />

  <article class="bq-blog-post">
    <header class="bq-blog-post-header">
      <Breadcrumb items={breadcrumbItems} />
      
      <div class="bq-blog-post-meta">
        <span class="bq-category-tag">{catLabel}</span>
        <time class="bq-publish-date" datetime={data.pubDate}>{formatDate(data.pubDate, data.lang)}</time>
        {data.updatedDate && (
          <time class="bq-updated-date" datetime={data.updatedDate}>{formatDate(data.updatedDate, data.lang)}</time>
        )}
      </div>

      <h1 class="bq-blog-post-title">{data.title}</h1>
      <p class="bq-blog-post-excerpt">{data.description}</p>

      <div class="bq-blog-post-meta-bottom">
        <span class="bq-reading-time">⏱ {readingTime} min de lecture</span>
        <SocialShare title={data.title} url={canonical} lang={data.lang} />
      </div>
    </header>

    <div class="bq-blog-post-content" set:html={body} />

    <footer class="bq-blog-post-footer">
      {data.tags.length > 0 && (
        <div class="bq-tags">
          {data.tags.map(tag => (
            <a href={`/${data.lang}/blog/tag/${slugify(tag)}/1`} class="bq-tag">{tag}</a>
          ))}
        </div>
      )}

      {data.series && (
        <div class="bq-series">
          <span class="bq-series-label">Série :</span>
          <a href={`/${data.lang}/blog/serie/${slugify(data.series)}/1`} class="bq-series-link">{data.series}</a>
        </div>
      )}
    </footer>

    <NewsletterForm lang={data.lang} />

    <RelatedPosts lang={data.lang} currentSlug={slug} category={data.category} tags={data.tags} series={data.series} />
  </article>
</MainLayout>

<style is:global>
  .bq-blog-post { max-width: 800px; margin: 0 auto; padding: var(--space-2xl) var(--space-md); }
  .bq-blog-post-header { text-align: center; margin-bottom: var(--space-2xl); padding-bottom: var(--space-xl); border-bottom: 1px solid var(--line); }
  .bq-blog-post-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-md); margin-bottom: var(--space-lg); font-size: var(--text-sm); color: var(--muted); }
  .bq-category-tag { background: var(--gold-soft); color: var(--gold-ink); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  .bq-publish-date, .bq-updated-date { font-family: Georgia, serif; }
  .bq-blog-post-title { font-family: Georgia, serif; font-size: clamp(28px, 4vw, 44px); font-weight: 400; line-height: 1.15; color: var(--ink); margin: 0 0 var(--space-md); }
  .bq-blog-post-excerpt { color: var(--muted); font-size: var(--text-lg); font-family: Georgia, serif; margin: 0 0 var(--space-xl); max-width: 700px; margin-left: auto; margin-right: auto; }
  .bq-blog-post-meta-bottom { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-md); font-size: var(--text-sm); color: var(--muted); }
  .bq-reading-time { font-family: Georgia, serif; }
  .bq-blog-post-content { font-size: var(--text-base); line-height: 1.8; color: var(--ink); }
  .bq-blog-post-content h2 { font-family: Georgia, serif; font-size: clamp(22px, 3vw, 30px); font-weight: 400; color: var(--ink); margin: var(--space-2xl) 0 var(--space-md); padding-bottom: var(--space-xs); border-bottom: 2px solid var(--gold); }
  .bq-blog-post-content h3 { font-family: Georgia, serif; font-size: clamp(18px, 2.5vw, 24px); font-weight: 400; color: var(--ink); margin: var(--space-xl) 0 var(--space-sm); }
  .bq-blog-post-content p { margin: var(--space-md) 0; }
  .bq-blog-post-content blockquote { border-left: 3px solid var(--gold); padding-left: var(--space-lg); margin: var(--space-xl) 0; font-style: italic; color: var(--muted); }
  .bq-blog-post-content ul, .bq-blog-post-content ol { margin: var(--space-md) 0; padding-left: var(--space-xl); }
  .bq-blog-post-content li { margin: var(--space-xs) 0; }
  .bq-blog-post-content a { color: var(--gold-ink); text-decoration: underline; text-underline-offset: 2px; }
  .bq-blog-post-content a:hover { color: var(--ink); }
  .bq-blog-post-content img { max-width: 100%; height: auto; border-radius: var(--radius-lg); }
  .bq-blog-post-footer { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--line); }
  .bq-tags { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-md); }
  .bq-tag { background: var(--paper); border: 1px solid var(--line); color: var(--ink); padding: var(--space-xs) var(--space-md); border-radius: var(--radius-full); font-size: var(--text-sm); text-decoration: none; transition: all var(--transition-fast); }
  .bq-tag:hover { background: var(--gold-soft); border-color: var(--gold); color: var(--gold-ink); }
  .bq-series { display: flex; align-items: center; gap: var(--space-sm); font-size: var(--text-sm); color: var(--muted); }
  .bq-series-label { font-weight: 500; }
  .bq-series-link { color: var(--gold-ink); text-decoration: none; font-weight: 500; }
  .bq-series-link:hover { text-decoration: underline; }
</style>