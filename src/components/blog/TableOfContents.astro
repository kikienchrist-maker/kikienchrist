---
// TableOfContents.astro - TOC auto-généré (design system lafoidieu .bq classes)
interface Props {
  content: string | undefined;
  lang?: string;
}

const { content, lang = 'fr' } = Astro.props;

function extractHeadings(html: string): { level: number; text: string; id: string }[] {
  const headings: { level: number; text: string; id: string }[] = [];
  const regex = /<h([23])[^>]*id="([^"]+)"[^>]*>(.*?)<\/h[23]>/gi;
  let match;
  
  while ((match = regex.exec(html)) !== null) {
    const level = parseInt(match[1], 10);
    const id = match[2];
    const text = match[3].replace(/<[^>]+>/g, '');
    headings.push({ level, text, id });
  }
  
  return headings;
}

const headings = content ? extractHeadings(content) : [];

const ui = {
  fr: { title: 'Sommaire', backToTop: 'Haut de page' },
  en: { title: 'Contents', backToTop: 'Back to top' },
  es: { title: 'Contenido', backToTop: 'Volver arriba' },
  pt: { title: 'Sumário', backToTop: 'Voltar ao topo' },
  it: { title: 'Sommario', backToTop: 'Torna su' },
  de: { title: 'Inhalt', backToTop: 'Nach oben' },
  nl: { title: 'Inhoud', backToTop: 'Terug naar boven' },
  pl: { title: 'Spis treści', backToTop: 'Wróć na górę' },
  ar: { title: 'المحتويات', backToTop: 'العودة للأعلى' },
};

const t = ui[lang as keyof typeof ui] || ui.fr;
---

{headings.length > 0 && (
  <nav class="bq-toc" aria-labelledby="toc-title">
    <h3 id="toc-title" class="bq-toc-title">{t.title}</h3>
    <ul class="bq-toc-list" role="list">
      {headings.map((heading, index) => (
        <li class="bq-toc-item" style={{ '--toc-level': heading.level, '--item-index': index }}>
          <a 
            href={`#${heading.id}`} 
            class="bq-toc-link"
            data-heading-id={heading.id}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
    <a href="#" class="bq-toc-back-to-top">{t.backToTop}</a>
  </nav>
)}

<script>
  class TableOfContents {
    toc: HTMLElement;
    list: HTMLElement;
    links: NodeListOf<HTMLAnchorElement>;
    headings: NodeListOf<HTMLElement>;
    observer: IntersectionObserver | null = null;
    activeLink: HTMLAnchorElement | null = null;
    
    constructor(toc: HTMLElement) {
      this.toc = toc;
      this.list = toc.querySelector('.bq-toc-list')!;
      this.links = toc.querySelectorAll('.bq-toc-link');
      
      const article = document.querySelector('.bq-blog-post-content') || document.querySelector('article');
      if (!article) return;
      
      this.headings = article.querySelectorAll('h2[id], h3[id]');
      if (this.headings.length === 0) return;
      
      this.init();
    }
    
    init() {
      this.observeHeadings();
      this.bindScroll();
      this.bindClicks();
    }
    
    observeHeadings() {
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          const link = this.toc.querySelector(`.bq-toc-link[data-heading-id="${entry.target.id}"]`);
          if (link && entry.isIntersecting) {
            this.setActive(link as HTMLAnchorElement);
          }
        });
      }, { rootMargin: '-100px 0px -66%', threshold: 0 });
      
      this.headings.forEach(h => this.observer!.observe(h));
    }
    
    bindScroll() {
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            this.updateOnScroll();
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    }
    
    updateOnScroll() {
      // Fallback if observer misses
    }
    
    bindClicks() {
      this.links.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.getAttribute('href')?.slice(1);
          const target = document.getElementById(targetId || '');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.pushState(null, '', `#${targetId}`);
            this.setActive(link);
          }
        });
      });
    }
    
    setActive(link: HTMLAnchorElement) {
      if (this.activeLink) this.activeLink.classList.remove('bq-active');
      link.classList.add('bq-active');
      this.activeLink = link;
    }
  }
  
  document.addEventListener('DOMContentLoaded', () => {
    const tocs = document.querySelectorAll('.bq-toc');
    tocs.forEach(toc => new TableOfContents(toc as HTMLElement));
  });
</script>

<style is:global>
  .bq-toc { position: sticky; top: 100px; max-height: calc(100vh - 120px); overflow-y: auto; padding: var(--space-md); background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); margin-bottom: var(--space-xl); }
  .bq-toc-title { font-size: var(--text-sm); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 0 0 var(--space-md); padding-bottom: var(--space-sm); border-bottom: 1px solid var(--line); }
  .bq-toc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .bq-toc-item { padding-left: calc(var(--toc-level, 2) * 1rem); }
  .bq-toc-link { color: var(--ink); text-decoration: none; font-size: var(--text-sm); line-height: 1.5; transition: color var(--transition-fast); display: block; padding: var(--space-xs) 0; }
  .bq-toc-link:hover { color: var(--gold-ink); }
  .bq-toc-link.bq-active { color: var(--gold-ink); font-weight: 500; }
  .bq-toc-back-to-top { display: block; margin-top: var(--space-md); padding-top: var(--space-md); border-top: 1px solid var(--line); font-size: var(--text-xs); color: var(--muted); text-decoration: none; text-align: center; transition: color var(--transition-fast); }
  .bq-toc-back-to-top:hover { color: var(--gold-ink); }
</style>