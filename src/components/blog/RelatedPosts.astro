---
// RelatedPosts.astro - Articles liés (design system lafoidieu .bq)
import type { CollectionEntry } from 'astro:content';
import BlogPostCard from './BlogPostCard.astro';
import { getCollection } from 'astro:content';
import { getRelatedPosts, type BlogPostData } from '../../utils/blog';

interface Props {
  currentSlug: string;
  currentLang: string;
  category?: string;
  tags?: string[];
  series?: string;
  limit?: number;
}

const { currentSlug, currentLang, category, tags = [], series, limit = 3 } = Astro.props;

const allEntries = await getCollection('blog', ({ data }) => data.lang === currentLang && !data.draft);

const allPosts: BlogPostData[] = allEntries.map(entry => ({
  ...entry.data,
  slug: entry.slug,
  body: '',
}));

const relatedPostsData = getRelatedPosts({
  allPosts,
  currentSlug,
  category,
  tags,
  series,
  limit,
});

const relatedPosts = allEntries.filter(entry => 
  relatedPostsData.some(r => r.slug === entry.slug)
);

const ui = {
  fr: { title: 'Continuer votre lecture', readMore: 'Lire la suite' },
  en: { title: 'Continue reading', readMore: 'Read more' },
  es: { title: 'Continuar leyendo', readMore: 'Leer más' },
  pt: { title: 'Continuar lendo', readMore: 'Ler mais' },
  it: { title: 'Continua a leggere', readMore: 'Leggi tutto' },
  de: { title: 'Weiterlesen', readMore: 'Weiterlesen' },
  nl: { title: 'Lees verder', readMore: 'Lees meer' },
  pl: { title: 'Kontynuuj czytanie', readMore: 'Czytaj dalej' },
  ar: { title: 'متابعة القراءة', readMore: 'اقرأ المزيد' },
};

const t = ui[currentLang as keyof typeof ui] || ui.fr;
---

{relatedPosts.length > 0 && (
  <section class="bq-related-posts" aria-labelledby="related-posts-title">
    <h2 id="related-posts-title" class="bq-section-title">{t.title}</h2>
    <div class="bq-related-posts-grid" role="list">
      {relatedPosts.map(post => (
        <BlogPostCard 
          post={post} 
          lang={currentLang}
          readMoreText={t.readMore}
        />
      ))}
    </div>
  </section>
)}

<style is:global>
  .bq-related-posts { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--line); }
  .bq-related-posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-lg); }
</style>