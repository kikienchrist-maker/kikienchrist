---
// BlogIndex.astro - Page d'index du blog unifiée (design system lafoidieu .bq)
import type { CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import BlogPostCard from './BlogPostCard.astro';
import CategoryFilter from './CategoryFilter.astro';
import TagCloud from './TagCloud.astro';
import Pagination from '../Pagination.astro';
import NewsletterForm from '../NewsletterForm.astro';
import Breadcrumb from '../Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { generateBlogJsonLd } from '../../utils/blog';

interface Props {
  lang: string;
  category?: string;
  tag?: string;
  series?: string;
  page?: number;
  perPage?: number;
  posts?: CollectionEntry<'blog'>[];
  pagination?: { currentPage: number; totalPages: number; pageSize: number };
}

const { lang, category, tag, series, page = 1, perPage = 10, posts: passedPosts, pagination: passedPagination } = Astro.props;

let allPosts: CollectionEntry<'blog'>[];
let filteredPosts: CollectionEntry<'blog'>[];
let totalPosts: number;
let totalPages: number;
let currentPage: number;
let posts: CollectionEntry<'blog'>[];

if (passedPosts && passedPagination) {
  allPosts = passedPosts;
  filteredPosts = passedPosts;
  totalPosts = passedPagination.totalItems || passedPosts.length;
  totalPages = passedPagination.totalPages;
  currentPage = passedPagination.currentPage;
  posts = passedPosts;
} else {
  allPosts = (await getCollection('blog', ({ data }) => data.lang === lang && !data.draft))
    .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

  filteredPosts = allPosts;
  if (category) filteredPosts = filteredPosts.filter(p => p.data.category === category);
  if (tag) filteredPosts = filteredPosts.filter(p => p.data.tags.includes(tag));
  if (series) filteredPosts = filteredPosts.filter(p => p.data.series === series);

  totalPosts = filteredPosts.length;
  totalPages = Math.ceil(totalPosts / perPage);
  currentPage = Math.max(1, Math.min(page, totalPages));
  const start = (currentPage - 1) * perPage;
  const end = start + perPage;
  posts = filteredPosts.slice(start, end);
}

function getCategoryLabel(cat: string, lng: string): string {
  const labels: Record<string, Record<string, string>> = {
    fr: { priere: 'Prière', temoignage: 'Témoignage', enseignement: 'Enseignement', 'vie-chretienne': 'Vie chrétienne', ressources: 'Ressources' },
    en: { priere: 'Prayer', temoignage: 'Testimony', enseignement: 'Teaching', 'vie-chretienne': 'Christian Life', ressources: 'Resources' },
    es: { priere: 'Oración', temoignage: 'Testimonio', enseignement: 'Enseñanza', 'vie-chretienne': 'Vida cristiana', ressources: 'Recursos' },
    pt: { priere: 'Oração', temoignage: 'Testemunho', enseignement: 'Ensino', 'vie-chretienne': 'Vida cristã', ressources: 'Recursos' },
    it: { priere: 'Preghiera', temoignage: 'Testimonianza', enseignement: 'Insegnamento', 'vie-chretienne': 'Vita cristiana', ressources: 'Risorse' },
    de: { priere: 'Gebet', temoignage: 'Zeugnis', enseignement: 'Lehre', 'vie-chretienne': 'Christliches Leben', ressources: 'Ressourcen' },
    nl: { priere: 'Gebed', temoignage: 'Getuigenis', enseignement: 'Onderwijs', 'vie-chretienne': 'Christelijk leven', ressources: 'Hulpbronnen' },
    pl: { priere: 'Modlitwa', temoignage: 'Świadectwo', enseignement: 'Nauczanie', 'vie-chretienne': 'Życie chrześcijańskie', ressources: 'Zasoby' },
    ar: { priere: 'الصلاة', temoignage: 'الشهادة', enseignement: 'التعليم', 'vie-chretienne': 'الحياة المسيحية', ressources: 'الموارد' },
    hi: { priere: 'प्रार्थना', temoignage: 'गवाही', enseignement: 'शिक्षा', 'vie-chretienne': 'ईसाई जीवन', ressources: 'संसाधन' },
    zh: { priere: '祷告', temoignage: '见证', enseignement: '教导', 'vie-chretienne': '基督徒生活', ressources: '资源' },
  };
  return labels[lng]?.[cat] || labels['fr']?.[cat] || cat;
}

function getSeriesLabel(s: string, lng: string): string {
  const labels: Record<string, Record<string, string>> = {
    fr: { 'apprendre-à-prier': 'Apprendre à prier' },
    en: { 'apprendre-à-prier': 'Learn to Pray' },
    es: { 'apprendre-à-prier': 'Aprender a orar' },
    pt: { 'apprendre-à-prier': 'Aprender a orar' },
    it: { 'apprendre-à-prier': 'Imparare a pregare' },
    de: { 'apprendre-à-prier': 'Beteln lernen' },
    nl: { 'apprendre-à-prier': 'Leren bidden' },
    pl: { 'apprendre-à-prier': 'Ucz się modlić' },
    ar: { 'apprendre-à-prier': 'تعلم الصلاة' },
    hi: { 'apprendre-à-prier': 'प्रार्थना करना सीखें' },
    zh: { 'apprendre-à-prier': '学习祷告' },
  };
  return labels[lng]?.[s] || labels['fr']?.[s] || s;
}

// Métadonnées SEO
const pageTitle = category
  ? `Blog — ${getCategoryLabel(category, lang)} | Kiki en Christ`
  : tag
    ? `Blog — Tag « ${tag} » | Kiki en Christ`
    : series
      ? `Blog — Série « ${getSeriesLabel(series, lang)} » | Kiki en Christ`
      : `Blog — Articles & Ressources | Kiki en Christ`;

const pageDescription = category
  ? `Découvrez tous nos articles sur « ${getCategoryLabel(category, lang)} » : prière, formation, témoignage, vie chrétienne...`
  : tag
    ? `Articles étiquetés « ${tag} » sur Kiki en Christ.`
    : series
      ? `Tous les articles de la série « ${getSeriesLabel(series, lang)} ».`
      : 'Articles, enseignements, témoignages et ressources pour grandir dans votre foi. Blog chrétien multilingue.';

// URL canonique
const baseUrl = new URL(`/${lang}/blog/`, Astro.site);
if (category) baseUrl.pathname += `categorie/${category}/`;
else if (tag) baseUrl.pathname += `tag/${tag}/`;
else if (series) baseUrl.pathname += `serie/${series.toLowerCase().replace(/\s+/g, '-')}/`;
if (currentPage > 1) baseUrl.pathname += `page/${currentPage}/`;

const canonical = baseUrl.toString();

// JSON-LD Blog
const jsonLd = generateBlogJsonLd(posts, Astro.site?.toString() || 'https://kikienchrist.vercel.app');

// Traductions UI
const ui = {
  fr: { filterTitle: 'Filtrer', categories: 'Catégories', tags: 'Mots-clés', series: 'Séries', clearFilters: 'Effacer les filtres', noPosts: 'Aucun article trouvé.', readingTime: 'min de lecture', relatedPosts: 'Articles similaires', newsletterTitle: 'Recevez nos nouveaux articles', newsletterDesc: 'Inscrivez-vous pour ne rien manquer de nos enseignements et témoignages.', subscribe: 'S\'abonner' },
  en: { filterTitle: 'Filter', categories: 'Categories', tags: 'Tags', series: 'Series', clearFilters: 'Clear filters', noPosts: 'No articles found.', readingTime: 'min read', relatedPosts: 'Related posts', newsletterTitle: 'Get new articles', newsletterDesc: 'Subscribe to never miss our teachings and testimonies.', subscribe: 'Subscribe' },
  es: { filterTitle: 'Filtrar', categories: 'Categorías', tags: 'Etiquetas', series: 'Series', clearFilters: 'Borrar filtros', noPosts: 'No se encontraron artículos.', readingTime: 'min de lectura', relatedPosts: 'Artículos relacionados', newsletterTitle: 'Recibe nuevos artículos', newsletterDesc: 'Suscríbete para no perderte nuestras enseñanzas y testimonios.', subscribe: 'Suscribirse' },
  pt: { filterTitle: 'Filtrar', categories: 'Categorias', tags: 'Tags', series: 'Séries', clearFilters: 'Limpar filtros', noPosts: 'Nenhum artigo encontrado.', readingTime: 'min de leitura', relatedPosts: 'Artigos relacionados', newsletterTitle: 'Receba novos artigos', newsletterDesc: 'Inscreva-se para não perder nossos ensinamentos e testemunhos.', subscribe: 'Inscrever-se' },
  it: { filterTitle: 'Filtra', categories: 'Categorie', tags: 'Tag', series: 'Serie', clearFilters: 'Cancella filtri', noPosts: 'Nessun articolo trovato.', readingTime: 'min di lettura', relatedPosts: 'Articoli correlati', newsletterTitle: 'Ricevi nuovi articoli', newsletterDesc: 'Iscriviti per non perdere i nostri insegnamenti e testimonianze.', subscribe: 'Iscriviti' },
  de: { filterTitle: 'Filtern', categories: 'Kategorien', tags: 'Schlagwörter', series: 'Serien', clearFilters: 'Filter löschen', noPosts: 'Keine Artikel gefunden.', readingTime: 'Min. Lesezeit', relatedPosts: 'Ähnliche Artikel', newsletterTitle: 'Neue Artikel erhalten', newsletterDesc: 'Abonnieren Sie, um keine Lehren und Zeugnisse zu verpassen.', subscribe: 'Abonnieren' },
  nl: { filterTitle: 'Filteren', categories: 'Categorieën', tags: 'Tags', series: 'Series', clearFilters: 'Filters wissen', noPosts: 'Geen artikelen gevonden.', readingTime: 'min lezen', relatedPosts: 'Gerelateerde artikelen', newsletterTitle: 'Ontvang nieuwe artikelen', newsletterDesc: 'Abonneer om geen lessen en getuigenissen te missen.', subscribe: 'Abonneren' },
  pl: { filterTitle: 'Filtruj', categories: 'Kategorie', tags: 'Tagi', series: 'Serie', clearFilters: 'Wyczyść filtry', noPosts: 'Nie znaleziono artykułów.', readingTime: 'min czytania', relatedPosts: 'Pokrewne artykuły', newsletterTitle: 'Otrzymuj nowe artykuły', newsletterDesc: 'Zapisz się, by nie przegapić naszych nauczania i świadectw.', subscribe: 'Zapisz się' },
  ar: { filterTitle: 'تصفية', categories: 'الفئات', tags: 'الوسوم', series: 'السلاسل', clearFilters: 'مسح الفلاتر', noPosts: 'لم يتم العثور على مقالات.', readingTime: 'دقيقة قراءة', relatedPosts: 'مقالات ذات صلة', newsletterTitle: 'احصل على المقالات الجديدة', newsletterDesc: 'اشترك لكي لا تفوت تعاليمنا وشهاداتنا.', subscribe: 'اشترك' },
  hi: { filterTitle: 'फ़िल्टर', categories: 'श्रेणियाँ', tags: 'टैग', series: 'श्रृंखला', clearFilters: 'फ़िल्टर साफ़ करें', noPosts: 'कोई लेख नहीं मिला।', readingTime: 'मिनट पढ़ें', relatedPosts: 'संबंधित लेख', newsletterTitle: 'नए लेख प्राप्त करें', newsletterDesc: 'सदस्यता लें ताकि आप हमारी शिक्षाओं और गवाहियों से न चूकें।', subscribe: 'सदस्यता लें' },
  zh: { filterTitle: '筛选', categories: '分类', tags: '标签', series: '系列', clearFilters: '清除筛选', noPosts: '未找到文章。', readingTime: '分钟阅读', relatedPosts: '相关文章', newsletterTitle: '获取新文章', newsletterDesc: '订阅以免错过我们的教导和见证。', subscribe: '订阅' },
};

const t = ui[lang] || ui.fr;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  lang={lang}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <article class="blog-index">
    
    {/* Header */}
    <header class="blog-header">
      <div class="eyebrow">
        <span>Blog</span>
      </div>
      <h1>{category ? getCategoryLabel(category, lang) : tag ? `#${tag}` : series ? getSeriesLabel(series, lang) : 'Articles & Ressources'}</h1>
      {(!category && !tag && !series) && (
        <p class="lead">Articles, enseignements, témoignages et ressources pour grandir dans votre foi.</p>
      )}
    </header>

    <div class="blog-grid">
      {/* Sidebar */}
      <aside class="blog-sidebar" aria-label={t.filterTitle}>
        {category || tag || series ? (
          <div class="active-filters">
            <span class="filter-label">Filtres actifs :</span>
            <div class="filter-chips">
              {category && (
                <span class="filter-chip">
                  {getCategoryLabel(category, lang)}
                  <a href={`/${lang}/blog/`} class="clear-filters" aria-label={t.clearFilters}>×</a>
                </span>
              )}
              {tag && (
                <span class="filter-chip">
                  #{tag}
                  <a href={`/${lang}/blog/`} class="clear-filters" aria-label={t.clearFilters}>×</a>
                </span>
              )}
              {series && (
                <span class="filter-chip">
                  {getSeriesLabel(series, lang)}
                  <a href={`/${lang}/blog/`} class="clear-filters" aria-label={t.clearFilters}>×</a>
                </span>
              )}
            </div>
            <a href={`/${lang}/blog/`} class="clear-filters">{t.clearFilters}</a>
          </div>
        ) : null}

        <section class="sidebar-section" aria-labelledby="cat-title">
          <h3 class="sidebar-title" id="cat-title">{t.categories}</h3>
          <CategoryFilter 
            lang={lang} 
            currentCategory={category} 
            allCategories={['priere', 'temoignage', 'enseignement', 'vie-chretienne', 'ressources']}
            posts={allPosts}
          />
        </section>

        <section class="sidebar-section" aria-labelledby="tag-title">
          <h3 class="sidebar-title" id="tag-title">{t.tags}</h3>
          <TagCloud lang={lang} currentTag={tag} posts={allPosts} />
        </section>

        {allPosts.some(p => p.data.series) && (
          <section class="sidebar-section" aria-labelledby="series-title">
            <h3 class="sidebar-title" id="series-title">{t.series}</h3>
            <div class="series-list">
              {
                (() => {
                  const seriesCounts = {};
                  for (const p of allPosts) {
                    if (p.data.series) {
                      seriesCounts[p.data.series] = (seriesCounts[p.data.series] || 0) + 1;
                    }
                  }
                  return Object.entries(seriesCounts).map(([seriesKey, count]) => (
                    <a href={`/${lang}/blog/serie/${seriesKey.toLowerCase().replace(/\s+/g, '-')}/`} class="series-item">
                      <span>{getSeriesLabel(seriesKey, lang)}</span>
                      <span class="series-badge">{count}</span>
                    </a>
                  ));
                })()
              }
            </div>
          </section>
        )}
      </aside>

      {/* Main Content */}
      <main class="blog-main">
        {posts.length > 0 ? (
          <>
            <div class="blog-posts-grid" role="list">
              {posts.map(post => (
                <BlogPostCard 
                  post={post} 
                  lang={lang} 
                  readMoreText={t.readingTime} 
                  featuredText="Mis en avant"
                />
              ))}
            </div>

            {/* Pagination */}
            {totalPages > 1 && (
              <nav class="pagination" aria-label="Pagination">
                {currentPage > 1 && (
                  <a href={currentPage === 2 ? baseUrl.pathname.replace(/\/page\/[^/]+/, '') : baseUrl.pathname.replace(/page\/[^/]+/, `page/${currentPage - 1}/`)} rel="prev">← Précédent</a>
                )}
                {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
                  p === currentPage ? (
                    <span class="current" aria-current="page">{p}</span>
                  ) : (
                    <a href={p === 1 ? baseUrl.pathname : `${baseUrl.pathname}page/${p}/`}>{p}</a>
                  )
                ))}
                {currentPage < totalPages && (
                  <a href={`${baseUrl.pathname}page/${currentPage + 1}/`} rel="next">Suivant →</a>
                )}
              </nav>
            )}

            {/* Newsletter CTA Bottom */}
            <section class="newsletter-cta-bottom">
              <div class="eyebrow"><span>Newsletter</span></div>
              <h2>{t.newsletterTitle}</h2>
              <p>{t.newsletterDesc}</p>
              <NewsletterForm lang={lang} />
            </section>
          </>
        ) : (
          <div style="text-align:center; padding: var(--space-3xl); color: var(--color-ink-light);">
            <p>{t.noPosts}</p>
            <a href={`/${lang}/blog/`} class="btn btn-primary" style="margin-top: var(--space-lg); display: inline-block;">← Retour au blog</a>
          </div>
        )}
      </main>
    </div>
  </article>
</MainLayout>