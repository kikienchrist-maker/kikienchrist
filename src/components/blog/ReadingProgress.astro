---
// ReadingProgress.astro - Barre de progression de lecture en haut de page
---

<div class="reading-progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Progression de lecture">
  <div class="reading-progress-bar"></div>
</div>

<script>
  // Lecture progress bar
  class ReadingProgress {
    progressBar: HTMLElement;
    progressContainer: HTMLElement;
    article: HTMLElement | null;
    lastScrollY: number = 0;
    ticking: boolean = false;
    
    constructor(container: HTMLElement) {
      this.progressContainer = container;
      this.progressBar = container.querySelector('.reading-progress-bar')!;
      this.article = document.querySelector('.blog-post-content') || document.querySelector('article');
      
      if (!this.article) return;
      
      this.init();
    }
    
    init() {
      window.addEventListener('scroll', () => this.onScroll(), { passive: true });
      window.addEventListener('resize', () => this.updateProgress(), { passive: true });
      
      // Initial update
      this.updateProgress();
    }
    
    onScroll() {
      this.lastScrollY = window.scrollY;
      
      if (!this.ticking) {
        window.requestAnimationFrame(() => {
          this.updateProgress();
          this.ticking = false;
        });
        this.ticking = true;
      }
    }
    
    updateProgress() {
      if (!this.article) return;
      
      const articleTop = this.article.getBoundingClientRect().top + window.scrollY;
      const articleHeight = this.article.offsetHeight;
      const viewportHeight = window.innerHeight;
      const scrollTop = window.scrollY;
      
      // Début de l'article (après header)
      const start = articleTop - 100; // Offset pour header sticky
      const end = start + articleHeight - viewportHeight;
      
      let progress = 0;
      
      if (scrollTop >= start) {
        progress = Math.min((scrollTop - start) / Math.max(end - start, 1), 1);
      }
      
      const percent = Math.round(progress * 100);
      
      // Update bar
      this.progressBar.style.width = `${percent}%`;
      
      // Update aria
      this.progressContainer.setAttribute('aria-valuenow', String(percent));
    }
  }
  
  // Initialiser
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.reading-progress');
    if (container) new ReadingProgress(container as HTMLElement);
  });
</script>

<style is:global>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--color-border);
    z-index: 1000;
    pointer-events: none;
    transition: opacity var(--transition-normal);
  }

  .reading-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--color-gold), var(--color-gold-dark));
    width: 0%;
    transition: width 0.1s linear;
    transform-origin: left center;
  }

  /* Cacher sur mobile si nécessaire */
  @media (max-width: 480px) {
    .reading-progress {
      height: 2px;
    }
  }
</style>