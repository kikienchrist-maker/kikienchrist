---
// CategoryFilter.astro - Sidebar filtre catégories avec compteurs
import type { CollectionEntry } from 'astro:content';
import { getCategoryLabel } from '../../utils/blog';

interface Props {
  lang: string;
  currentCategory?: string;
  allCategories: string[];
  posts: CollectionEntry<'blog'>[];
}

const { lang, currentCategory, allCategories, posts } = Astro.props;

// Compter articles par catégorie
const categoryCounts: Record<string, number> = {};
for (const post of posts) {
  if (!post.data.draft) {
    categoryCounts[post.data.category] = (categoryCounts[post.data.category] || 0) + 1;
  }
}

const ui = {
  fr: { title: 'Catégories', all: 'Toutes' },
  en: { title: 'Categories', all: 'All' },
  es: { title: 'Categorías', all: 'Todas' },
  pt: { title: 'Categorias', all: 'Todas' },
  it: { title: 'Categorie', all: 'Tutte' },
  de: { title: 'Kategorien', all: 'Alle' },
  nl: { title: 'Categorieën', all: 'Alle' },
  pl: { title: 'Kategorie', all: 'Wszystkie' },
  ar: { title: 'التصنيفات', all: 'الكل' },
};

const t = ui[lang as keyof typeof ui] || ui.fr;
---

<nav class="category-filter" aria-labelledby="category-filter-title">
  <h3 id="category-filter-title" class="filter-title">{t.title}</h3>
  
  <ul class="category-list" role="list">
    <li class="category-item">
      <a 
        href={`/${lang}/blog/`} 
        class={`category-link ${!currentCategory ? 'active' : ''}`}
        aria-current={!currentCategory ? 'page' : undefined}
      >
        <span class="category-name">{t.all}</span>
        <span class="category-count">{posts.filter(p => !p.data.draft).length}</span>
      </a>
    </li>
    
    {allCategories.map(cat => {
      const count = categoryCounts[cat] || 0;
      const label = getCategoryLabel(cat, lang);
      return (
        <li class="category-item">
          <a 
            href={`/${lang}/blog/categorie/${cat}/`} 
            class={`category-link ${currentCategory === cat ? 'active' : ''}`}
            aria-current={currentCategory === cat ? 'page' : undefined}
          >
            <span class="category-name">{label}</span>
            <span class="category-count">{count}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style is:global>
  .category-filter {
    margin-bottom: var(--space-xl);
  }

  .filter-title {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0 0 var(--space-md);
    color: var(--color-ink);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .category-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .category-item {
    margin-bottom: var(--space-xs);
  }

  .category-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    text-decoration: none;
    transition: all var(--transition-fast);
    font-size: var(--text-sm);
  }

  .category-link:hover {
    background: var(--color-gold-light);
    color: var(--color-gold);
  }

  .category-link.active {
    background: var(--color-gold);
    color: var(--color-paper);
    font-weight: 600;
  }

  .category-link.active .category-count {
    background: rgba(255, 255, 255, 0.2);
    color: var(--color-paper);
  }

  .category-name {
    flex: 1;
  }

  .category-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 var(--space-sm);
    background: var(--color-gold-light);
    color: var(--color-gold);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .category-link.active .category-count {
    background: rgba(255, 255, 255, 0.2);
    color: var(--color-paper);
  }
</style>