    defaultDesc: 'Subscribe for new articles, prayer guides, and weekly encouragement.',
    emailPlaceholder: 'Your email',
    submit: 'Subscribe',
    submitting: 'Subscribing...',
    success: 'Thanks! Check your inbox.',
    error: 'Error. Please try again later.',
