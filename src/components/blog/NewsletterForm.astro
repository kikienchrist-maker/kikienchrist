const t = ui[lang] || ui.fr;

const formTitle = title || t.defaultTitle;
const formDescription = description || t.defaultDesc;
const leadMagnetNote = leadMagnetTitle ? t.leadMagnetNote : '';
---

<form 
  class="bq-newsletter-form" 
  name="newsletter" 
  method="POST" 
  data-netlify="true" 
  data-netlify-honeypot="bot-field"
  novalidate
>
  <input type="hidden" name="form-name" value="newsletter" />
  <input type="hidden" name="lang" value={lang} />
  
  {/* Honeypot */}
  <div class="bq-honeypot" aria-hidden="true" style="display: none;">
    <label for="bot-field">Ne remplissez pas ce champ</label>
    <input type="text" id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" />
  </div>

  <div class="bq-form-header">
    <h3 class="bq-form-title">{formTitle}</h3>
    <p class="bq-form-description">{formDescription}</p>
  </div>

  {leadMagnetUrl && leadMagnetTitle && (
    <div class="bq-lead-magnet-preview">
      <p class="bq-lead-magnet-note">{leadMagnetNote}</p>
      <a href={leadMagnetUrl} target="_blank" rel="noopener noreferrer" class="bq-lead-magnet-link">
        <span class="bq-lead-magnet-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </span>
        <span class="bq-lead-magnet-title">{leadMagnetTitle}</span>
        <span class="bq-lead-magnet-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 9 15 15"/>
          </svg>
        </span>
      </a>
    </div>
  )}

  <div class="bq-form-field">
    <label for="email" class="bq-sr-only">{t.emailPlaceholder}</label>
    <input 
      type="email" 
      id="email" 
      name="email" 
      placeholder={t.emailPlaceholder}
      required
      autocomplete="email"
      class="bq-form-input"
      aria-describedby="email-help"
    />
    <span id="email-help" class="bq-form-help">{t.privacy}</span>
  </div>

  <button type="submit" class="bq-btn bq-btn-primary bq-btn-full bq-form-submit">
    <span class="bq-form-submit-text">{t.submit}</span>
    <span class="bq-form-submit-loading" hidden>{t.submitting}</span>
    <svg class="bq-form-submit-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
      <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
      <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round" stroke-dasharray="30" stroke-dashoffset="30"/>
    </svg>
  </button>

  <p class="bq-form-message" aria-live="polite" hidden></p>
</form>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const forms = document.querySelectorAll('.bq-newsletter-form');
    forms.forEach(form => {
      const submitBtn = form.querySelector('.bq-form-submit');
      const submitText = form.querySelector('.bq-form-submit-text');
      const submitLoading = form.querySelector('.bq-form-submit-loading');
      const spinner = form.querySelector('.bq-form-submit-spinner');
      const message = form.querySelector('.bq-form-message');
      
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // UI loading state
        submitBtn.disabled = true;
        submitText.hidden = true;
        submitLoading.hidden = false;
        spinner.hidden = false;
        message.hidden = true;
        message.textContent = '';
        message.classList.remove('bq-form-message--success', 'bq-form-message--error');
        
        const formData = new FormData(form);
        
        try {
          const response = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData).toString(),
          });
          
          if (response.ok) {
            message.textContent = t.success;
            message.classList.add('bq-form-message--success');
            form.reset();
          } else {
            throw new Error('Submission failed');
          }
        } catch {
          message.textContent = t.error;
          message.classList.add('bq-form-message--error');
        } finally {
          submitBtn.disabled = false;
          submitText.hidden = false;
          submitLoading.hidden = true;
          spinner.hidden = true;
          message.hidden = false;
          
          setTimeout(() => {
            message.hidden = true;
            message.classList.remove('bq-form-message--success', 'bq-form-message--error');
          }, 8000);
        }
      });
    });
  });
</script>

<style is:global>
  .bq-newsletter-form { display: flex; flex-direction: column; gap: var(--space-md); max-width: 480px; margin: 0 auto; }
  .bq-honeypot { position: absolute; left: -9999px; }
  .bq-form-header { text-align: center; }
  .bq-form-title { font-family: Georgia, serif; font-size: var(--text-xl); font-weight: 400; color: var(--ink); margin: 0 0 var(--space-xs); }
  .bq-form-description { color: var(--muted); margin: 0; font-size: var(--text-base); }
  .bq-lead-magnet-preview { 
    background: var(--gold-soft); 
    border: 1px solid var(--gold); 
    border-radius: var(--radius-lg); 
    padding: var(--space-md); 
    display: flex; 
    flex-direction: column; 
    gap: var(--space-sm); 
  }
  .bq-lead-magnet-note { font-size: var(--text-xs); color: var(--muted); margin: 0; text-align: center; }
  .bq-lead-magnet-link { 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    gap: var(--space-sm); 
    padding: var(--space-sm) var(--space-md); 
    background: var(--paper); 
    border: 1px solid var(--line); 
    border-radius: var(--radius-md); 
    color: var(--ink); 
    text-decoration: none; 
    font-size: var(--text-sm); 
    font-weight: 500; 
    transition: all var(--transition-fast); 
  }
  .bq-lead-magnet-link:hover { background: var(--gold); border-color: var(--gold); color: var(--ink); }
  .bq-lead-magnet-icon, .bq-lead-magnet-arrow { width: 18px; height: 18px; flex-shrink: 0; color: var(--gold-ink); }
  .bq-form-field { display: flex; flex-direction: column; gap: var(--space-xs); }
  .bq-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .bq-form-input {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--ink);
    font-size: var(--text-base);
    font-family: inherit;
    transition: all var(--transition-fast);
  }
  .bq-form-input:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-soft); }
  .bq-form-help { font-size: var(--text-xs); color: var(--muted); text-align: center; }
  .bq-form-submit { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-sm); position: relative; }
  .bq-form-submit-spinner { width: 20px; height: 20px; animation: bq-spin 1s linear infinite; }
  @keyframes bq-spin { to { transform: rotate(360deg); } }
  .bq-form-message { font-size: var(--text-sm); text-align: center; margin: 0; }
  .bq-form-message--success { color: #2e7d32; }
  .bq-form-message--error { color: #c62828; }
</style>