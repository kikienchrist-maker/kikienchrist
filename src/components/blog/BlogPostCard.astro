---
// BlogPostCard.astro - Carte article unifiée (design system lafoidieu .bq classes)
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCategoryLabel } from '../../utils/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  lang?: string;
  readMoreText?: string;
  featuredText?: string;
}

const { post, lang = 'fr', readMoreText = 'Lire la suite', featuredText = 'Mis en avant' } = Astro.props;
const { data, slug } = post;
const catLabel = getCategoryLabel(data.category, lang);

const heroImage = data.ogImage || `/images/blog/${data.category}-default.jpg`;

const readingTime = data.readingTime || Math.ceil((post.body?.split(/\s+/).length || 0) / 200);
---

<article class="bq-blog-post-card" itemscope itemtype="https://schema.org/BlogPosting" role="listitem">
  <a href={`/${lang}/blog/${slug}/`} class="bq-card-link" aria-label={`${data.title} - ${catLabel}`}>
    
    {/* Image */}
    <div class="bq-card-image">
      {heroImage && (
        <Image
          src={heroImage}
          alt=""
          width={400}
          height={225}
          format="avif"
          quality={75}
          loading="lazy"
          itemprop="image"
        />
      )}
      {data.featured && (
        <span class="bq-badge bq-badge--featured" itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
          <span itemprop="name">{featuredText}</span>
        </span>
      )}
    </div>

    {/* Contenu */}
    <div class="bq-card-content">
      {/* Meta */}
      <div class="bq-card-meta">
        <span class="bq-card-category" itemprop="articleSection">{catLabel}</span>
        <time 
          class="bq-card-date" 
          itemprop="datePublished" 
          dateTime={data.pubDate}
        >
          {new Date(data.pubDate).toLocaleDateString(lang, { 
            day: 'numeric', month: 'short', year: 'numeric' 
          })}
        </time>
      </div>

      {/* Titre */}
      <h2 class="bq-card-title" itemprop="headline">{data.title}</h2>

      {/* Extrait */}
      <p class="bq-card-excerpt" itemprop="description">{data.description}</p>

      {/* Footer */}
      <div class="bq-card-footer">
        <span class="bq-card-reading-time" itemprop="timeRequired" content={`PT${readingTime}M`}>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="14" height="14">
            <circle cx="10" cy="10" r="8"/>
            <path d="M10 6v4l3 3"/>
          </svg>
          {readingTime} min
        </span>
        {data.author && (
          <span class="bq-card-author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <span itemprop="name">{data.author}</span>
          </span>
        )}
      </div>

      <span class="bq-card-read-more">{readMoreText} →</span>
    </div>
  </a>
</article>

<style is:global>
  .bq-blog-post-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .bq-blog-post-card:hover {
    border-color: var(--gold);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }
  .bq-card-link { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .bq-card-image { position: relative; overflow: hidden; aspect-ratio: 16/9; }
  .bq-card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-slow); }
  .bq-blog-post-card:hover .bq-card-image img { transform: scale(1.05); }
  .bq-badge--featured {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    background: var(--gold);
    color: var(--ink);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .05em;
  }
  .bq-card-content { display: flex; flex-direction: column; flex: 1; padding: var(--space-md); }
  .bq-card-meta { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-sm); font-size: var(--text-xs); color: var(--muted); }
  .bq-card-category { background: var(--gold-soft); color: var(--gold-ink); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius-full); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  .bq-card-title { font-family: Georgia, serif; font-size: var(--text-lg); font-weight: 400; line-height: 1.3; color: var(--ink); margin: var(--space-xs) 0 var(--space-sm); transition: color var(--transition-fast); }
  .bq-blog-post-card:hover .bq-card-title { color: var(--gold-ink); }
  .bq-card-excerpt { color: var(--muted); font-size: var(--text-sm); line-height: 1.6; margin: 0; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .bq-card-footer { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-top: var(--space-sm); padding-top: var(--space-sm); border-top: 1px solid var(--line); font-size: var(--text-xs); color: var(--muted); }
  .bq-card-reading-time, .bq-card-author { display: inline-flex; align-items: center; gap: var(--space-xs); }
  .bq-card-read-more { margin-top: var(--space-sm); font-size: var(--text-sm); font-weight: 500; color: var(--gold-ink); display: inline-block; transition: transform var(--transition-fast); }
  .bq-blog-post-card:hover .bq-card-read-more { transform: translateX(4px); }
</style>