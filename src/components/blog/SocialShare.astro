---
// SocialShare.astro - Partage social (design system lafoidieu .bq classes)
interface Props {
  url: string;
  title: string;
  description: string;
  image?: string;
  lang?: string;
  class?: string;
}

const { 
  url, 
  title, 
  description, 
  image,
  lang = 'fr',
  class: className = '',
} = Astro.props;

const socialNetworks = [
  { 
    id: 'facebook', 
    label: 'Facebook', 
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>',
    url: (u: string) => `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(u)}`,
  },
  { 
    id: 'twitter', 
    label: 'X', 
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>',
    url: (u: string, t: string) => `https://twitter.com/intent/tweet?url=${encodeURIComponent(u)}&text=${encodeURIComponent(t)}`,
  },
  { 
    id: 'linkedin', 
    label: 'LinkedIn', 
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>',
    url: (u: string) => `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(u)}`,
  },
  { 
    id: 'whatsapp', 
    label: 'WhatsApp', 
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.77 11.77 0 0 0 12 0C5.37 0 0 5.37 0 12c0 1.78.39 3.5 1.08 5.06L0 24l6.13-1.61c1.56.69 3.28 1.08 5.06 1.08 6.63 0 12-5.37 12-12 0-1.77-.39-3.5-1.07-5.06zM12 18.88c-1.7 0-3.3-.5-4.66-1.38l-2.3.65.66-2.41c-.88-.88-1.34-2.16-1.38-3.96 0-3.63 2.97-6.6 6.6-6.6s6.6 2.97 6.6 6.6c0 1.8-.5 3.48-1.38 4.65l.66 2.4-2.3.65c-1.36-.88-2.96-1.38-4.66-1.38z"/></svg>',
    url: (u: string, t: string) => `https://wa.me/?text=${encodeURIComponent(`${t} ${u}`)}`,
  },
  { 
    id: 'telegram', 
    label: 'Telegram', 
    icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.91 3.79L10.08 18.12c-.42.34-1.04.25-1.29-.17l-1.67-2.91c-.15-.28-.02-.63.26-.7l2.14-1.58 5.76-6.53c.34-.36.9-.36 1.24 0l6.42 7.32c.35.38.33.96-.06 1.23z"/></svg>',
    url: (u: string, t: string) => `https://t.me/share/url?url=${encodeURIComponent(u)}&text=${encodeURIComponent(t)}`,
  },
  { 
    id: 'email', 
    label: 'Email', 
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
    url: (u: string, t: string) => `mailto:?subject=${encodeURIComponent(t)}&body=${encodeURIComponent(`${t}\n\n${u}`)}`,
  },
  { 
    id: 'copy', 
    label: 'Copier', 
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>',
    url: null,
  },
];

const ui = {
  fr: { share: 'Partager', copied: 'Copié !', copyLink: 'Copier le lien' },
  en: { share: 'Share', copied: 'Copied!', copyLink: 'Copy link' },
  es: { share: 'Compartir', copied: '¡Copiado!', copyLink: 'Copiar enlace' },
  pt: { share: 'Compartilhar', copied: 'Copiado!', copyLink: 'Copiar link' },
  it: { share: 'Condividi', copied: 'Copiato!', copyLink: 'Copia link' },
  de: { share: 'Teilen', copied: 'Kopiert!', copyLink: 'Link kopieren' },
  nl: { share: 'Delen', copied: 'Gekopieerd!', copyLink: 'Kopieer link' },
  pl: { share: 'Udostępnij', copied: 'Skopiowano!', copyLink: 'Kopiuj link' },
  ar: { share: 'مشاركة', copied: 'تم النسخ!', copyLink: 'نسخ الرابط' },
};

const t = ui[lang as keyof typeof ui] || ui.fr;
---

<div class="bq-social-share" data-url={url} data-title={title}>
  <button 
    class="bq-social-share-trigger" 
    aria-expanded="false" 
    aria-controls="social-share-menu"
    aria-label={t.share}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="bq-social-share-icon" aria-hidden="true">
      <circle cx="18" cy="5" r="3" />
      <circle cx="6" cy="19" r="3" />
      <circle cx="18" cy="19" r="3" />
      <path d="M8.59 13.51L16.18 6" />
      <path d="M17.5 18.09A6 6 0 0 1 5 15" />
      <path d="M21.5 7.91A6 6 0 0 1 13 4" />
    </svg>
    <span class="bq-social-share-text">{t.share}</span>
  </button>

  <div id="social-share-menu" class="bq-social-share-dropdown" role="menu" aria-label={t.share} hidden>
    <div class="bq-social-share-menu">
      {socialNetworks.map(network => (
        network.url ? (
          <a
            href={network.url(url, title)}
            target="_blank"
            rel="noopener noreferrer"
            class="bq-social-share-link"
            role="menuitem"
            aria-label={network.label}
            data-network={network.id}
          >
            <span class="bq-social-share-link-icon" set:html={network.icon} />
            <span class="bq-social-share-link-label">{network.label}</span>
          </a>
        ) : (
          <button
            type="button"
            class="bq-social-share-link"
            role="menuitem"
            aria-label={network.label}
            data-action="copy-link"
            data-network={network.id}
          >
            <span class="bq-social-share-link-icon" set:html={network.icon} />
            <span class="bq-social-share-link-label">{t.copyLink}</span>
          </button>
        )
      ))}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll('.bq-social-share-trigger');
    triggers.forEach(trigger => {
      const container = trigger.closest('.bq-social-share');
      if (!container) return;
      
      const dropdown = container.querySelector('.bq-social-share-dropdown');
      const menu = container.querySelector('.bq-social-share-menu');
      let isOpen = false;
      let closeTimeout: number;

      const open = () => {
        dropdown.hidden = false;
        requestAnimationFrame(() => {
          dropdown.classList.add('bq-open');
        });
        trigger.setAttribute('aria-expanded', 'true');
        isOpen = true;
      };

      const close = () => {
        dropdown.classList.remove('bq-open');
        setTimeout(() => {
          if (!isOpen) dropdown.hidden = true;
        }, 200);
        trigger.setAttribute('aria-expanded', 'false');
        isOpen = false;
      };

      const toggle = () => {
        if (isOpen) close();
        else open();
      };

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle();
      });

      dropdown.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.hasAttribute('data-action')) {
          if (target.getAttribute('data-action') === 'copy-link') {
            navigator.clipboard.writeText(url).then(() => {
              const originalText = target.querySelector('.bq-social-share-link-label');
              if (originalText) {
                const oldText = originalText.textContent;
                originalText.textContent = t.copied;
                setTimeout(() => { originalText.textContent = oldText; }, 2000);
              }
            });
          }
        }
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (isOpen && !container.contains(e.target as Node)) {
          close();
        }
      });

      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) close();
      });
    });
  });
</script>

<style is:global>
  .bq-social-share { display: inline-flex; position: relative; }
  .bq-social-share-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .bq-social-share-trigger:hover { background: var(--gold-soft); border-color: var(--gold); color: var(--gold-ink); }
  .bq-social-share-icon { width: 18px; height: 18px; }
  .bq-social-share-dropdown {
    position: absolute;
    bottom: calc(100% + var(--space-sm));
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-fast), transform var(--transition-fast), visibility var(--transition-fast);
    z-index: 100;
  }
  .bq-social-share-dropdown.bq-open {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .bq-social-share-menu {
    display: flex;
    gap: var(--space-xs);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-sm);
  }
  .bq-social-share-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
  }
  .bq-social-share-link:hover { background: var(--gold-soft); color: var(--gold-ink); }
  .bq-social-share-link-icon { width: 20px; height: 20px; flex-shrink: 0; }
  .bq-social-share-link-label { white-space: nowrap; }
</style>