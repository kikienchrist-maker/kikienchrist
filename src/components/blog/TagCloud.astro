---
// TagCloud.astro - Nuage de tags (design system lafoidieu .bq)
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: string;
  currentTag?: string;
  posts: CollectionEntry<'blog'>[];
  limit?: number;
}

const { lang, currentTag, posts, limit = 20 } = Astro.props;

const tagCounts: Record<string, number> = {};
for (const post of posts) {
  if (!post.data.draft) {
    for (const tag of post.data.tags) {
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    }
  }
}

const sortedTags = Object.entries(tagCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, limit);

const counts = sortedTags.map(([, count]) => count);
const maxCount = Math.max(...counts, 1);
const minCount = Math.min(...counts);

const ui = {
  fr: { title: 'Mots-clés' },
  en: { title: 'Tags' },
  es: { title: 'Etiquetas' },
  pt: { title: 'Tags' },
  it: { title: 'Tag' },
  de: { title: 'Schlagwörter' },
  nl: { title: 'Tags' },
  pl: { title: 'Tagi' },
  ar: { title: 'الوسوم' },
};

const t = ui[lang as keyof typeof ui] || ui.fr;

function getTagSize(count: number): string {
  if (maxCount === minCount) return '1rem';
  const ratio = (count - minCount) / (maxCount - minCount);
  const minSize = 0.8;
  const maxSize = 1.3;
  const size = minSize + ratio * (maxSize - minSize);
  return `${size.toFixed(2)}rem`;
}
---

{sortedTags.length > 0 && (
  <div class="bq-tag-cloud" aria-label={t.title}>
    <div class="bq-tag-cloud-list" role="list">
      {sortedTags.map(([tag, count]) => (
        <a
          href={`/${lang}/blog/tag/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
          class="bq-tag-item"
          style={{ fontSize: getTagSize(count) }}
          aria-label={`${tag} (${count} article${count > 1 ? 's' : ''})`}
          aria-current={currentTag === tag ? 'page' : undefined}
        >
          {tag}
        </a>
      ))}
    </div>
  </div>
)}

<style is:global>
  .bq-tag-cloud { margin-bottom: var(--space-xl); }
  .bq-tag-cloud-list { display: flex; flex-wrap: wrap; gap: var(--space-sm); justify-content: center; }
  .bq-tag-item {
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--ink);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
    line-height: 1.5;
  }
  .bq-tag-item:hover { background: var(--gold-soft); border-color: var(--gold); color: var(--gold-ink); }
  .bq-tag-item[aria-current="page"] { background: var(--gold-ink); border-color: var(--gold-ink); color: var(--cream); }
</style>