---
// LanguageSwitcher.astro — Dropdown langue avec drapeaux emoji (lafoidieu design system .bq classes)

interface Props {
  currentLang: string;
  currentPath: string; // ex: "/fr/", "/fr/livres", "/en/blog/..."
}

const { currentLang, currentPath } = Astro.props;

// 11 langues supportées avec drapeaux (emoji) et noms natifs
const LANGUAGES: Record<string, { label: string; flag: string; native: string }> = {
  fr: { label: 'Français', flag: '🇫🇷', native: 'Français' },
  en: { label: 'English', flag: '🇺🇸', native: 'English' },
  es: { label: 'Español', flag: '🇪🇸', native: 'Español' },
  pt: { label: 'Português', flag: '🇵🇹', native: 'Português' },
  it: { label: 'Italiano', flag: '🇮🇹', native: 'Italiano' },
  de: { label: 'Deutsch', flag: '🇩🇪', native: 'Deutsch' },
  nl: { label: 'Nederlands', flag: '🇳🇱', native: 'Nederlands' },
  pl: { label: 'Polski', flag: '🇵🇱', native: 'Polski' },
  ar: { label: 'العربية', flag: '🇸🇦', native: 'العربية' },
  ru: { label: 'Русский', flag: '🇷🇺', native: 'Русский' },
  zh: { label: '中文', flag: '🇨🇳', native: '中文' },
  hi: { label: 'हिन्दी', flag: '🇮🇳', native: 'हिन्दी' },
};

const current = LANGUAGES[currentLang] || LANGUAGES.fr;
const otherLangs = Object.entries(LANGUAGES).filter(([code]) => code !== currentLang);

// Construire le chemin vers l'autre langue : remplacer /{lang}/ au début
function switchLangPath(path: string, targetLang: string): string {
  const segments = path.split('/').filter(Boolean);
  if (segments[0] in LANGUAGES) {
    segments[0] = targetLang;
  } else {
    segments.unshift(targetLang);
  }
  return '/' + segments.join('/') + '/';
}
---

<div class="bq-lang-switcher" data-current-lang={currentLang}>
  <button
    class="bq-lang-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label="Changer de langue"
    type="button"
  >
    <span class="bq-lang-flag" aria-hidden="true">{current.flag}</span>
    <span class="bq-lang-code">{currentLang.toUpperCase()}</span>
    <svg class="bq-lang-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>

  <div class="bq-lang-dropdown" role="listbox" aria-label="Langues disponibles" hidden>
    {otherLangs.map(([code, lang]) => (
      <a
        class="bq-lang-option"
        href={switchLangPath(currentPath, code)}
        role="option"
        aria-selected={code === currentLang}
        hreflang={code}
        lang={code}
      >
        <span class="bq-lang-option-flag" aria-hidden="true">{lang.flag}</span>
        <span class="bq-lang-option-native">{lang.native}</span>
        <span class="bq-lang-option-label">{lang.label}</span>
      </a>
    ))}
  </div>
</div>

<script>
  // Toggle dropdown + close on outside click + keyboard navigation
  document.addEventListener('DOMContentLoaded', () => {
    const switchers = document.querySelectorAll('.bq-lang-switcher');
    switchers.forEach(switcher => {
      const trigger = switcher.querySelector('.bq-lang-trigger');
      const dropdown = switcher.querySelector('.bq-lang-dropdown');
      const options = dropdown?.querySelectorAll('.bq-lang-option');

      if (!trigger || !dropdown) return;

      // Toggle
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !dropdown.hidden;
        dropdown.hidden = isOpen;
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!switcher.contains(e.target as Node)) {
          dropdown.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
        }
      });

      // Keyboard navigation
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          dropdown.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
          trigger.focus();
        } else if (e.key === 'ArrowDown' && dropdown.hidden) {
          e.preventDefault();
          dropdown.hidden = false;
          trigger.setAttribute('aria-expanded', 'true');
          options?.[0]?.focus();
        }
      });

      options?.forEach((opt, i) => {
        opt.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            options?.[(i + 1) % options.length]?.focus();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            options?.[(i - 1 + options.length) % options.length]?.focus();
          } else if (e.key === 'Escape') {
            dropdown.hidden = true;
            trigger.setAttribute('aria-expanded', 'false');
            trigger.focus();
          }
        });
      });
    });
  });
</script>

<style is:global>
  /* Language Switcher - standalone .bq-* classes */
  .bq-lang-switcher {
    position: relative;
    display: inline-flex;
    z-index: 100;
  }

  .bq-lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    min-width: 72px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font: 500 var(--text-sm) system-ui, sans-serif;
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
  }
  .bq-lang-trigger:hover {
    border-color: var(--gold);
    box-shadow: var(--shadow-sm);
  }
  .bq-lang-trigger:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .bq-lang-flag {
    font-size: 1.1em;
    line-height: 1;
  }
  .bq-lang-code {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .bq-lang-chevron {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--muted);
    transition: transform var(--transition-fast);
  }
  .bq-lang-trigger[aria-expanded="true"] .bq-lang-chevron {
    transform: rotate(180deg);
  }

  .bq-lang-dropdown {
    position: absolute;
    top: calc(100% + var(--space-xs));
    right: 0;
    min-width: 220px;
    max-height: 380px;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-xs);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
    z-index: 50;
  }
  .bq-lang-dropdown:not([hidden]) {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .bq-lang-option {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    font: var(--text-sm) system-ui, sans-serif;
    transition: background var(--transition-fast);
  }
  .bq-lang-option:hover,
  .bq-lang-option:focus {
    background: var(--gold-soft);
    outline: none;
  }
  .bq-lang-option:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: -2px;
  }
  .bq-lang-option[aria-selected="true"] {
    background: var(--gold-soft);
    font-weight: 600;
  }

  .bq-lang-option-flag {
    font-size: 1.1em;
    line-height: 1;
    flex-shrink: 0;
    width: 28px;
    text-align: center;
  }
  .bq-lang-option-native {
    flex: 1;
    text-align: left;
    font-family: inherit;
  }
  .bq-lang-option-label {
    color: var(--muted);
    font-size: 0.85em;
    white-space: nowrap;
  }

  /* RTL support for Arabic */
  .bq-lang-option[lang="ar"],
  .bq-lang-option[lang="ar"] .bq-lang-option-native {
    direction: rtl;
    text-align: right;
  }
</style>