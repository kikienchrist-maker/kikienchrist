---
// src/components/LanguageSwitcher.astro
// Sélecteur de langue accessible : role="combobox", aria-expanded, focus management

import { SUPPORTED_LANGS, LANG_NAMES } from '../utils/i18n';
import { getTranslations } from '../utils/translations';

interface Props {
  currentLang: string;
  currentPath: string; // ex: "/fr/blog/"
}

const { currentLang, currentPath } = Astro.props;
const t = getTranslations(currentLang);

// Générer URLs pour chaque langue
const langOptions = SUPPORTED_LANGS.map(lang => {
  const base = currentPath.replace(/^\/[a-z]{2}(-[A-Z]{2})?\//, '/');
  return {
    code: lang,
    name: LANG_NAMES[lang as keyof typeof LANG_NAMES] || lang,
    nativeName: LANG_NAMES[lang as keyof typeof LANG_NAMES] || lang,
    url: `/${lang}${base}`,
    current: lang === currentLang,
  };
});
---

<div class="bq-language-switcher" data-lang={currentLang}>
  <label for="lang-select" class="bq-sr-only">{t.nav?.language || 'Langue'}</label>
  
  <!-- Bouton déclencheur (combobox) -->
  <button
    type="button"
    id="lang-select"
    class="bq-lang-trigger"
    role="combobox"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="lang-listbox"
    aria-label={t.nav?.language || 'Changer de langue'}
    aria-activedescendant=""
  >
    <span class="bq-lang-current" aria-hidden="true">
      <span class="bq-lang-flag" data-flag={currentLang}></span>
      <span class="bq-lang-code">{currentLang.toUpperCase()}</span>
    </span>
    <svg class="bq-lang-chevron" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
      <path fill="none" stroke="currentColor" stroke-width="2" d="M6 9l6 6 6-6"/>
    </svg>
  </button>

  <!-- Liste des options (listbox) -->
  <div
    id="lang-listbox"
    class="bq-lang-dropdown"
    role="listbox"
    aria-label={t.nav?.language || 'Choisir une langue'}
    hidden
  >
    <ul class="bq-lang-list" role="presentation">
      {langOptions.map(opt => (
        <li role="presentation">
          <button
            type="button"
            role="option"
            aria-selected={opt.current}
            class={`bq-lang-option ${opt.current ? 'bq-active' : ''}`}
            data-lang={opt.code}
            data-url={opt.url}
            onclick="window.location.href=this.dataset.url"
          >
            <span class="bq-lang-flag" data-flag={opt.code}></span>
            <span class="bq-lang-native">{opt.nativeName}</span>
            <span class="bq-lang-english">({opt.name})</span>
            {opt.current && <svg class="bq-check" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"><path fill="currentColor" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>}
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  (function() {
    const trigger = document.getElementById('lang-select');
    const dropdown = document.getElementById('lang-listbox');
    const options = dropdown?.querySelectorAll('[role="option"]');
    if (!trigger || !dropdown || !options.length) return;
    
    let isOpen = false;
    let activeIndex = -1;
    
    function open() {
      dropdown.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      isOpen = true;
      // Focus sur l'option active
      const active = dropdown.querySelector('[aria-selected="true"]');
      if (active) active.focus();
      document.addEventListener('click', outsideClick);
      document.addEventListener('keydown', onKeydown);
    }
    
    function close() {
      dropdown.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      isOpen = false;
      document.removeEventListener('click', outsideClick);
      document.removeEventListener('keydown', onKeydown);
    }
    
    function outsideClick(e) {
      if (!trigger.contains(e.target) && !dropdown.contains(e.target)) close();
    }
    
    function onKeydown(e) {
      if (!isOpen) return;
      const opts = Array.from(options);
      switch (e.key) {
        case 'Escape': close(); trigger.focus(); break;
        case 'ArrowDown': e.preventDefault(); activeIndex = Math.min(activeIndex + 1, opts.length - 1); opts[activeIndex].focus(); break;
        case 'ArrowUp': e.preventDefault(); activeIndex = Math.max(activeIndex - 1, 0); opts[activeIndex].focus(); break;
        case 'Home': e.preventDefault(); activeIndex = 0; opts[0].focus(); break;
        case 'End': e.preventDefault(); activeIndex = opts.length - 1; opts[activeIndex].focus(); break;
        case 'Enter': case ' ': e.preventDefault(); opts[activeIndex].click(); break;
        case 'Tab': close(); break;
      }
    }
    
    trigger.addEventListener('click', () => isOpen ? close() : open());
    options.forEach((opt, i) => {
      opt.addEventListener('focus', () => activeIndex = i);
      opt.addEventListener('click', close);
    });
  })();
</script>

<style is:global>
  .bq-language-switcher { position: relative; display: inline-block; }
  .bq-lang-trigger {
    display: inline-flex; align-items: center; gap: var(--bq-space-2);
    padding: var(--bq-space-2) var(--bq-space-3);
    background: var(--bq-color-surface); border: 2px solid var(--bq-color-border);
    border-radius: var(--bq-radius-md); font-size: var(--bq-text-sm); font-weight: 500;
    color: var(--bq-color-text); cursor: pointer; transition: border-color 0.2s, box-shadow 0.2s;
    min-width: 120px; justify-content: space-between;
  }
  .bq-lang-trigger:hover { border-color: var(--bq-color-primary); }
  .bq-lang-trigger:focus { outline: none; border-color: var(--bq-color-primary); box-shadow: 0 0 0 3px var(--bq-color-focus); }
  .bq-lang-current { display: flex; align-items: center; gap: var(--bq-space-2); }
  .bq-lang-flag { width: 20px; height: 14px; border-radius: 2px; background-size: cover; background-position: center; }
  /* Flags via CSS - ajouter vos data-flag backgrounds */
  .bq-lang-flag[data-flag="fr"] { background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 3 2'><rect width='1' height='2' fill='%230055A4'/><rect x='1' width='1' height='2' fill='white'/><rect x='2' width='1' height='2' fill='%23EF4135'/></svg>"); }
  .bq-lang-flag[data-flag="en"] { background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 3 2'><rect width='3' height='2' fill='%2300247D'/><path d='M0 0L3 2M3 0L0 2' stroke='white' stroke-width='0.2'/><path d='M1.5 0V2M0 1H3' stroke='%23CF142B' stroke-width='0.2'/></svg>"); }
  .bq-lang-flag[data-flag="es"] { background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 3 2'><rect width='3' height='2' fill='%23AA151B'/><rect y='0.4' height='1.2' fill='%23F1BF00'/></svg>"); }
  /* ... autres drapeaux */
  .bq-lang-chevron { flex-shrink: 0; transition: transform 0.2s; }
  .bq-lang-trigger[aria-expanded="true"] .bq-lang-chevron { transform: rotate(180deg); }
  
  .bq-lang-dropdown {
    position: absolute; top: calc(100% + 4px); right: 0; z-index: 100;
    background: var(--bq-color-surface); border: 1px solid var(--bq-color-border);
    border-radius: var(--bq-radius-md); box-shadow: var(--bq-shadow-lg);
    min-width: 200px; max-height: 300px; overflow-y: auto;
  }
  .bq-lang-list { list-style: none; padding: var(--bq-space-1); margin: 0; }
  .bq-lang-option {
    display: flex; align-items: center; gap: var(--bq-space-2); width: 100%;
    padding: var(--bq-space-2) var(--bq-space-3); border: none; background: transparent;
    border-radius: var(--bq-radius-sm); text-align: left; cursor: pointer;
    font-size: var(--bq-text-sm); color: var(--bq-color-text); transition: background 0.15s;
  }
  .bq-lang-option:hover, .bq-lang-option:focus { background: var(--bq-color-hover); outline: none; }
  .bq-lang-option.bq-active { background: var(--bq-color-primary-bg); color: var(--bq-color-primary); }
  .bq-lang-native { font-weight: 500; }
  .bq-lang-english { font-size: var(--bq-text-xs); color: var(--bq-color-text-muted); margin-left: auto; }
  .bq-check { flex-shrink: 0; color: var(--bq-color-primary); }
</style>