---
// LegalLayout.astro - Layout commun pour pages légales (lafoidieu .bq classes)
import MainLayout from '../layouts/MainLayout.astro';
import fs from 'fs';
import path from 'path';
import { marked } from 'marked';

const translations = JSON.parse(fs.readFileSync(path.resolve('./src/data/translations.json'), 'utf-8'));

interface Props {
  title: string;
  description: string;
  slug: string;
  lang: string;
  lastUpdated: string;
  version: string;
  content: string;
  page?: any;
}

const {
  title,
  description,
  slug,
  lang,
  lastUpdated,
  version,
  content,
  page,
} = Astro.props;

const markdownContent = content || page?.data?.content || '';
if (!markdownContent) {
  console.warn(`[LegalLayout] Content manquant pour ${slug} (${lang})`);
}

const t = (translations[lang]?.legal as Record<string, Record<string, string>>) || translations.fr?.legal || {};
const common = (translations[lang]?.common as Record<string, string>) || translations.fr?.common || {};
const legalNav = (t.nav as Record<string, string>) || {};

import { gfmHeadingId } from 'marked-gfm-heading-id';
marked.use(gfmHeadingId());
const htmlContent = marked.parse(markdownContent, { async: false }) as string;

function generateTOC(html: string): { id: string; text: string; level: number }[] {
  const toc: { id: string; text: string; level: number }[] = [];
  const headingRegex = /<h([23])[^>]*id="([^"]+)"[^>]*>(.*?)<\/h[23]>/gi;
  let match;
  while ((match = headingRegex.exec(html)) !== null) {
    const level = parseInt(match[1], 10);
    const id = match[2];
    const text = match[3].replace(/<[^>]+>/g, '');
    toc.push({ id, text, level });
  }
  return toc;
}

const toc = generateTOC(htmlContent);

const baseUrl = 'https://kikienchrist.vercel.app';
const canonicalSlugs: Record<string, Record<string, string>> = {
  'mentions-legales': { fr: 'mentions-legales', en: 'legal', es: 'avis-legal', de: 'impressum', pt: 'termos-legais', it: 'note-legali', ru: 'юридическая-информация', zh: '法律声明', hi: 'कानूनी-नोटिस' },
  'confidentialite': { fr: 'confidentialite', en: 'privacy', es: 'privacidad', de: 'datenschutz', pt: 'privacidade', it: 'privacy', ru: 'политика-конфиденциальности', zh: '隐私政策', hi: 'गोपनीयता-नीति' },
  'cookies': { fr: 'cookies', en: 'cookies', es: 'cookies', de: 'cookies', pt: 'cookies', it: 'cookies', ru: 'cookies', zh: 'cookies', hi: 'cookies' },
  'cgv': { fr: 'cgv', en: 'tos', es: 'tyc', de: 'agb', pt: 'tc', it: 'tcv', ru: 'условия', zh: '条款', hi: 'नियम-शर्तें' },
  'accessibilite': { fr: 'accessibilite', en: 'accessibility', es: 'accesibilidad', de: 'barrierefreiheit', pt: 'acessibilidade', it: 'accessibilita', ru: 'доступность', zh: '无障碍', hi: 'पहुंच' },
};

const canonicalSlug = canonicalSlugs[slug]?.[lang] || slug;
const canonicalURL = `${baseUrl}/${lang}/${canonicalSlug}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  url: canonicalURL,
  inLanguage: lang,
  dateModified: lastUpdated,
  publisher: {
    '@type': 'Organization',
    name: 'Kiki en Christ',
    logo: { '@type': 'ImageObject', url: `${baseUrl}/logo.png` },
  },
};

const breadcrumbItems = [
  { label: common.home || 'Accueil', href: `/${lang}/` },
  { label: t.title || 'Mentions légales', href: `#` },
];
---

<MainLayout
  title={title}
  description={description}
  lang={lang}
  canonicalURL={canonicalURL}
  jsonLd={jsonLd}
  currentPath={`/${lang}/${canonicalSlug}/`}
>
  <article class="bq-legal-page">
    <header class="bq-legal-header">
      <nav class="bq-legal-breadcrumb" aria-label="Fil d'Ariane">
        <ol class="bq-breadcrumb-list">
          {breadcrumbItems.map((item, i) => (
            <li class="bq-breadcrumb-item">
              {i > 0 && <span class="bq-breadcrumb-separator" aria-hidden="true">/</span>}
              <a href={item.href} class="bq-breadcrumb-link">{item.label}</a>
            </li>
          ))}
          <li class="bq-breadcrumb-item" aria-current="page">
            <span class="bq-breadcrumb-separator" aria-hidden="true">/</span>
            <span class="bq-breadcrumb-current">{title}</span>
          </li>
        </ol>
      </nav>

      <h1 class="bq-legal-title">{title}</h1>
      <p class="bq-legal-description">{description}</p>

      <div class="bq-legal-meta">
        <time class="bq-legal-last-updated" datetime={lastUpdated}>
          {common.lastUpdated || 'Dernière mise à jour'} : {new Date(lastUpdated).toLocaleDateString(lang, { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <span class="bq-legal-version">{common.version || 'Version'} {version}</span>
      </div>
    </header>

    <div class="bq-legal-layout">
      <aside class="bq-legal-sidebar" aria-label={t.toc || 'Sommaire'}>
        {toc.length > 0 && (
          <nav class="bq-toc">
            <h2 class="bq-toc-title">{t.toc || 'Sommaire'}</h2>
            <ul class="bq-toc-list">
              {toc.map(item => (
                <li class="bq-toc-item" style={{ '--toc-level': item.level }}>
                  <a href={`#${item.id}`} class="bq-toc-link">{item.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </aside>

      <div class="bq-legal-content" set:html={htmlContent} />
    </div>

    <footer class="bq-legal-footer">
      <nav class="bq-legal-nav" aria-label={t.relatedPages || 'Autres pages légales'}>
        <h3 class="bq-legal-nav-title">{t.relatedPages || 'Autres pages légales'}</h3>
        <ul class="bq-legal-nav-list">
          {Object.entries(legalNav).map(([key, label]) => (
            <li><a href={`/${lang}/${key}/`} class="bq-legal-nav-link">{label}</a></li>
          ))}
        </ul>
      </nav>
    </footer>
  </article>
</MainLayout>

<style is:global>
  .bq-legal-page { max-width: 1140px; margin: 0 auto; padding: var(--space-2xl) var(--space-md); }
  .bq-legal-header { text-align: center; margin-bottom: var(--space-2xl); padding-bottom: var(--space-xl); border-bottom: 1px solid var(--line); }
  .bq-legal-breadcrumb { margin-bottom: var(--space-lg); text-align: left; max-width: 800px; margin-left: auto; margin-right: auto; }
  .bq-breadcrumb-list { display: flex; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; justify-content: center; gap: var(--space-xs); font-size: var(--text-sm); color: var(--muted); }
  .bq-breadcrumb-item { display: flex; align-items: center; }
  .bq-breadcrumb-separator { color: var(--line); }
  .bq-breadcrumb-link { color: var(--muted); text-decoration: none; transition: color var(--transition-fast); }
  .bq-breadcrumb-link:hover { color: var(--gold-ink); }
  .bq-breadcrumb-current { color: var(--ink); font-weight: 500; }
  .bq-legal-title { font-family: Georgia, serif; font-size: clamp(28px, 4vw, 44px); font-weight: 400; color: var(--ink); margin: 0 0 var(--space-md); }
  .bq-legal-description { color: var(--muted); font-size: var(--text-lg); font-family: Georgia, serif; margin: 0 0 var(--space-lg); max-width: 700px; margin-left: auto; margin-right: auto; }
  .bq-legal-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-md); font-size: var(--text-sm); color: var(--muted); font-family: Georgia, serif; }
  .bq-legal-layout { display: grid; grid-template-columns: 220px 1fr; gap: var(--space-2xl); max-width: 1140px; margin: 0 auto; }
  .bq-legal-sidebar { position: sticky; top: 100px; max-height: calc(100vh - 120px); overflow-y: auto; }
  .bq-toc-title { font-size: var(--text-sm); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 0 0 var(--space-md); padding-bottom: var(--space-sm); border-bottom: 1px solid var(--line); }
  .bq-toc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .bq-toc-item { padding-left: calc(var(--toc-level, 2) * 1rem); }
  .bq-toc-link { color: var(--ink); text-decoration: none; font-size: var(--text-sm); line-height: 1.5; transition: color var(--transition-fast); display: block; padding: var(--space-xs) 0; }
  .bq-toc-link:hover { color: var(--gold-ink); }
  .bq-legal-content { font-size: var(--text-base); line-height: 1.8; color: var(--ink); }
  .bq-legal-content h2 { font-family: Georgia, serif; font-size: clamp(22px, 3vw, 30px); font-weight: 400; color: var(--ink); margin: var(--space-2xl) 0 var(--space-md); padding-bottom: var(--space-xs); border-bottom: 2px solid var(--gold); }
  .bq-legal-content h3 { font-family: Georgia, serif; font-size: clamp(18px, 2.5vw, 24px); font-weight: 400; color: var(--ink); margin: var(--space-xl) 0 var(--space-sm); }
  .bq-legal-content p { margin: var(--space-md) 0; }
  .bq-legal-content ul, .bq-legal-content ol { margin: var(--space-md) 0; padding-left: var(--space-xl); }
  .bq-legal-content li { margin: var(--space-xs) 0; }
  .bq-legal-content a { color: var(--gold-ink); text-decoration: underline; text-underline-offset: 2px; }
  .bq-legal-content a:hover { color: var(--ink); }
  .bq-legal-footer { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--line); }
  .bq-legal-nav-title { font-size: var(--text-sm); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 0 0 var(--space-md); }
  .bq-legal-nav-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-md); }
  .bq-legal-nav-link { color: var(--ink); text-decoration: none; font-size: var(--text-sm); transition: color var(--transition-fast); }
  .bq-legal-nav-link:hover { color: var(--gold-ink); text-decoration: underline; }

  @media (max-width: 900px) {
    .bq-legal-layout { grid-template-columns: 1fr; }
    .bq-legal-sidebar { position: static; max-height: none; margin-bottom: var(--space-xl); padding-bottom: var(--space-xl); border-bottom: 1px solid var(--line); }
  }
</style>