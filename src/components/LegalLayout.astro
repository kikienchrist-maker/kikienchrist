---
// LegalLayout.astro - Layout commun pour pages légales
// Sidebar sommaire auto, SEO, JSON-LD WebPage, breadcrumb

import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import translations from '../data/translations.json';
import { marked } from 'marked';

interface Props {
  title: string;
  description: string;
  slug: string;           // mentions-legales | confidentialite | cookies | cgv | accessibilite
  lang: string;           // fr, en, es, pt, it, de, nl, pl, ar
  lastUpdated: string;    // ISO date
  version: string;
  content: string;        // Markdown source (sera converti en HTML)
}

const {
  title,
  description,
  slug,
  lang,
  lastUpdated,
  version,
  content,
  page, // page object from getCollection (fallback for content)
} = Astro.props;

// Fallback: si content pas passé en prop, essayer page.data.content (Astro type:'content')
const markdownContent = content || page?.data?.content || '';
if (!markdownContent) {
  console.warn(`[LegalLayout] Content manquant pour ${slug} (${lang})`);
}

// Récupérer les traductions pour la langue courante
const t = (translations[lang]?.legal as Record<string, Record<string, string>>) || translations.fr?.legal || {};
const common = (translations[lang]?.common as Record<string, string>) || translations.fr?.common || {};
const legalNav = (t.nav as Record<string, string>) || {};

// Convertir Markdown → HTML avec IDs sur headings (GFM heading IDs)
import { gfmHeadingId } from 'marked-gfm-heading-id';
marked.use(gfmHeadingId());
const htmlContent = marked.parse(markdownContent, { async: false }) as string;

// Générer le sommaire (TOC) depuis les h2/h3 du HTML rendu
function generateTOC(html: string): { id: string; text: string; level: number }[] {
  const toc: { id: string; text: string; level: number }[] = [];
  const headingRegex = /<h([23])[^>]*id="([^"]+)"[^>]*>(.*?)<\/h[23]>/gi;
  let match;
  while ((match = headingRegex.exec(html)) !== null) {
    const level = parseInt(match[1], 10);
    const id = match[2];
    const text = match[3].replace(/<[^>]+>/g, '');
    toc.push({ id, text, level });
  }
  return toc;
}

const toc = generateTOC(htmlContent);

// URLs canoniques par langue
const baseUrl = 'https://kikienchrist.vercel.app';
const canonicalSlugs: Record<string, Record<string, string>> = {
  'mentions-legales': { fr: 'mentions-legales', en: 'legal', es: 'avis-legal', de: 'impressum', pt: 'termos-legais', it: 'note-legali', ru: 'юридическая-информация', zh: '法律声明', hi: 'कानूनी-नोटिस' },
  'confidentialite': { fr: 'confidentialite', en: 'privacy', es: 'privacidad', de: 'datenschutz', pt: 'privacidade', it: 'privacy', ru: 'политика-конфиденциальности', zh: '隐私政策', hi: 'गोपनीयता-नीति' },
  'cookies': { fr: 'cookies', en: 'cookies', es: 'cookies', de: 'cookies', pt: 'cookies', it: 'cookies', ru: 'cookies', zh: 'cookies', hi: 'cookies' },
  'cgv': { fr: 'cgv', en: 'tos', es: 'tyc', de: 'agb', pt: 'tc', it: 'tcv', ru: 'условия', zh: '条款', hi: 'नियम-शर्तें' },
  'accessibilite': { fr: 'accessibilite', en: 'accessibility', es: 'accesibilidad', de: 'barrierefreiheit', pt: 'acessibilidade', it: 'accessibilita', ru: 'доступность', zh: '无障碍', hi: 'पहुंच' },
};

const canonicalSlug = canonicalSlugs[slug]?.[lang] || slug;
const canonicalURL = `${baseUrl}/${lang}/${canonicalSlug}/`;

// JSON-LD WebPage
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonicalURL,
  name: title,
  description: description,
  url: canonicalURL,
  inLanguage: lang,
  dateModified: lastUpdated,
  publisher: {
    '@type': 'Organization',
    name: 'Kiki en Christ',
    url: baseUrl,
    logo: { '@type': 'ImageObject', url: `${baseUrl}/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
};
---

<MainLayout lang={lang} translations={translations} title={title} description={description} canonicalURL={canonicalURL} jsonLd={jsonLd}>
  <article class="legal-page" aria-labelledby="legal-title">
    <header class="legal-header">
      <nav class="legal-breadcrumb breadcrumb" aria-label={common.breadcrumb || 'Fil d\'Ariane'}>
        <ol class="breadcrumb-list">
          <li><a href={`/${lang}/`}>{common.home || 'Accueil'}</a></li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
      <h1 id="legal-title" class="legal-title">{title}</h1>
      <p class="legal-meta">
        <time datetime={lastUpdated}>{new Date(lastUpdated).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <span class="legal-version">v{version}</span>
      </p>
    </header>

    <div class="legal-grid">
      <!-- Sidebar sommaire -->
      {toc.length > 0 && (
        <aside id="toc" class="legal-sidebar toc" aria-label={legalNav.tableOfContents || 'Sommaire'}>
          <nav class="legal-toc">
            <h2 class="toc-title">{legalNav.tableOfContents || 'Sommaire'}</h2>
            <ul class="toc-list">
              {toc.map(item => (
                <li class={`toc-item toc-level-${item.level}`}>
                  <a href={`#${item.id}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}

      <!-- Contenu principal -->
      <div class="legal-content" set:html={htmlContent} />

      <!-- Sidebar vide sur mobile (placeholder pour grille) -->
      <aside class="legal-sidebar-placeholder" aria-hidden="true" />
    </div>

    <footer class="legal-footer">
      <p>{legalNav.lastUpdated || 'Dernière mise à jour'}: <time datetime={lastUpdated}>{new Date(lastUpdated).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}</time></p>
      <p>{legalNav.version || 'Version'}: {version}</p>
      <nav aria-label={legalNav.otherPages || 'Autres pages légales'}>
        <ul class="legal-links">
          <li><a href={`/${lang}/mentions-legales/`}>{legalNav.mentionsLegales || 'Mentions légales'}</a></li>
          <li><a href={`/${lang}/confidentialite/`}>{legalNav.confidentialite || 'Politique de confidentialité'}</a></li>
          <li><a href={`/${lang}/cookies/`}>{legalNav.cookies || 'Politique des cookies'}</a></li>
          <li><a href={`/${lang}/cgv/`}>{legalNav.cgv || 'Conditions générales de vente'}</a></li>
          <li><a href={`/${lang}/accessibilite/`}>{legalNav.accessibilite || 'Accessibilité'}</a></li>
        </ul>
      </nav>
    </footer>
  </article>

  <style>
    .legal-page { max-width: 1140px; margin: 0 auto; padding: 2rem 1.5rem; }
    .legal-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border, #e5e5e5); }
    .legal-breadcrumb { margin-bottom: 1rem; font-size: 0.875rem; color: var(--color-text-muted, #666); }
    .breadcrumb-list { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
    .breadcrumb-list li { display: flex; align-items: center; gap: 0.5rem; }
    .breadcrumb-list li:not(:last-child)::after { content: '/'; color: var(--color-text-muted, #999); }
    .breadcrumb-list a { color: var(--color-primary, #2563eb); text-decoration: none; }
    .breadcrumb-list a:hover { text-decoration: underline; }
    .breadcrumb-list li[aria-current="page"] { color: var(--color-text, #1a1a1a); font-weight: 500; }
    .legal-title { margin: 0 0 0.5rem; font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; color: var(--color-text, #1a1a1a); line-height: 1.2; }
    .legal-meta { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 0; font-size: 0.875rem; color: var(--color-text-muted, #666); }
    .legal-version { background: var(--color-primary-light, #eff6ff); color: var(--color-primary, #2563eb); padding: 0.125rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }

    .legal-grid { display: grid; grid-template-columns: 260px 1fr 1fr; gap: 2rem; align-items: start; }
    .legal-sidebar { position: sticky; top: 100px; max-height: calc(100vh - 120px); overflow-y: auto; }
    .toc-title { font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted, #666); margin: 0 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--color-border, #e5e5e5); }
    .toc-list { list-style: none; margin: 0; padding: 0; }
    .toc-item { margin-bottom: 0.375rem; }
    .toc-item a { display: block; font-size: 0.875rem; color: var(--color-text, #1a1a1a); text-decoration: none; padding: 0.125rem 0; border-left: 2px solid transparent; padding-left: 0.75rem; transition: color 0.15s, border-color 0.15s; }
    .toc-item a:hover { color: var(--color-primary, #2563eb); border-color: var(--color-primary, #2563eb); }
    .toc-level-3 { margin-left: 1rem; }
    .toc-level-3 a { font-size: 0.8125rem; color: var(--color-text-muted, #555); }
    .legal-content { min-width: 0; }
    .legal-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.5rem; font-weight: 700; color: var(--color-text, #1a1a1a); scroll-margin-top: 120px; }
    .legal-content h3 { margin-top: 1.5rem; margin-bottom: 0.75rem; font-size: 1.125rem; font-weight: 600; color: var(--color-text, #1a1a1a); scroll-margin-top: 120px; }
    .legal-content p { margin: 1rem 0; line-height: 1.7; color: var(--color-text, #1a1a1a); }
    .legal-content ul, .legal-content ol { margin: 1rem 0; padding-left: 1.5rem; line-height: 1.7; color: var(--color-text, #1a1a1a); }
    .legal-content li { margin-bottom: 0.5rem; }
    .legal-content a { color: var(--color-primary, #2563eb); text-decoration: underline; }
    .legal-content a:hover { color: var(--color-primary-dark, #1d4ed8); }
    .legal-content strong { font-weight: 600; }
    .legal-content code { background: var(--color-bg, #f5f5f5); padding: 0.125rem 0.375rem; border-radius: 4px; font-size: 0.875em; }
    .legal-content blockquote { border-left: 4px solid var(--color-primary, #2563eb); padding-left: 1rem; margin: 1.5rem 0; color: var(--color-text-muted, #555); font-style: italic; }

    .legal-footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border, #e5e5e5); font-size: 0.875rem; color: var(--color-text-muted, #666); }
    .legal-links { display: flex; flex-wrap: wrap; gap: 1rem; list-style: none; margin: 1rem 0 0; padding: 0; }
    .legal-links a { color: var(--color-primary, #2563eb); text-decoration: none; }
    .legal-links a:hover { text-decoration: underline; }

    /* Mobile: sidebar en accordéon ou masquée */
    @media (max-width: 1024px) {
      .legal-grid { grid-template-columns: 1fr; }
      .legal-sidebar { position: static; max-height: none; order: -1; border-bottom: 1px solid var(--color-border, #e5e5e5); padding-bottom: 1.5rem; margin-bottom: 1.5rem; }
      .legal-sidebar-placeholder { display: none; }
    }
    @media (max-width: 640px) {
      .legal-page { padding: 1.5rem 1rem; }
      .legal-title { font-size: 1.5rem; }
    }

    /* Dark mode */
    @media (prefers-color-scheme: dark) {
      .legal-header, .toc-title { border-color: var(--color-border-dark, #333); }
      .legal-footer { border-color: var(--color-border-dark, #333); }
      .legal-content code { background: var(--color-bg-dark, #2a2a2a); }
      .legal-version { background: var(--color-primary-dark-bg, #1e3a5f); }
    }
  </style>
</MainLayout>