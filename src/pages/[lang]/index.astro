---
// [lang]/index.astro — Localized homepage using translations.json (lafoidieu .bq classes)
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import BookCard from '../../components/BookCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import FAQ from '../../components/FAQ.astro';
import CTAStrip from '../../components/CTAStrip.astro';
import translations from '../../data/translations.json';
import { SUPPORTED_LANGS, DEFAULT_LANG } from '../../utils/i18n.ts';


const books = [
  {
    id: 'visage',
    position: 1,
    name: "Le visage de Dieu : la quête de la spiritualité et de la transcendance",
    isbn: "9791035977887",
    numberOfPages: 331,
    inLanguage: "fr",
    image: "/images/books/visage-fr.jpg",
    offers: [
      { price: "13.90", priceCurrency: "EUR", url: "https://www.lulu.com/fr/shop/kiki-en-christ/le-visage-de-dieu-la-qu%C3%AAte-de-la-spiritualit%C3%A9-et-de-la-transcendance/paperback/product-z6gg2r.html", seller: { name: "Lulu" }, availability: "https://schema.org/InStock" },
      { price: "3.99", priceCurrency: "USD", url: "https://payhip.com/b/XnmIq", seller: { name: "Payhip" }, availability: "https://schema.org/InStock" },
      { price: "5.49", priceCurrency: "USD", url: "https://play.google.com/store/audiobooks/details?id=AQAAAECiySyJnM", seller: { name: "Google Play" }, availability: "https://schema.org/InStock" }
    ]
  },
  {
    id: 'trinite',
    position: 2,
    name: "Les secrets de la Trinité enfin dévoilés : une critique percutante",
    isbn: "9781447566359",
    numberOfPages: 146,
    inLanguage: "fr",
    image: "/images/books/trinite-fr.png",
    offers: [
      { price: "9.99", priceCurrency: "EUR", url: "https://www.lulu.com/shop/kiki-en-christ/les-secrets-de-la-trinit%C3%A9-enfin-d%C3%A9voil%C3%A9s-une-critique-percutante/paperback/product-nk9wg4.html", seller: { name: "Lulu" }, availability: "https://schema.org/InStock" },
      { price: "3.99", priceCurrency: "USD", url: "https://payhip.com/b/OH3xG", seller: { name: "Payhip" }, availability: "https://schema.org/InStock" },
      { price: "5.49", priceCurrency: "USD", url: "https://play.google.com/store/audiobooks/details?id=AQAAAEBi7BisaM", seller: { name: "Google Play" }, availability: "https://schema.org/InStock" }
    ]
  },
  {
    id: 'combat',
    position: 3,
    name: "Le dernier Combat : garder la Foi",
    isbn: "9781445771212",
    numberOfPages: 85,
    inLanguage: "fr",
    image: "/images/books/combat-fr.jpg",
    offers: [
      { price: "9.99", priceCurrency: "EUR", url: "https://www.lulu.com/shop/kiki-en-christ/le-dernier-combat-garder-la-foi/paperback/product-7kgm227.html", seller: { name: "Lulu" }, availability: "https://schema.org/InStock" },
      { price: "3.99", priceCurrency: "USD", url: "https://payhip.com/b/cxuzQ", seller: { name: "Payhip" }, availability: "https://schema.org/InStock" },
      { price: "5.49", priceCurrency: "USD", url: "https://play.google.com/store/audiobooks/details?id=AQAAAEAy2ESYZM", seller: { name: "Google Play" }, availability: "https://schema.org/InStock" }
    ]
  },
  {
    id: 'salut',
    position: 4,
    name: "Le mystère du Salut",
    isbn: "9781326838447",
    numberOfPages: 214,
    inLanguage: "fr",
    image: "/images/books/salut-fr.jpg",
    offers: [
      { price: "7.99", priceCurrency: "EUR", url: "https://www.lulu.com/shop/kiki-en-christ/le-myst%C3%A8re-du-salut/paperback/product-nvg4d9k.html", seller: { name: "Lulu" }, availability: "https://schema.org/InStock" },
      { price: "3.99", priceCurrency: "USD", url: "https://payhip.com/b/jXRqE", seller: { name: "Payhip" }, availability: "https://schema.org/InStock" },
      { price: "5.49", priceCurrency: "USD", url: "https://play.google.com/store/audiobooks/details?id=AQAAAEByGxlbeM", seller: { name: "Google Play" }, availability: "https://schema.org/InStock" }
    ]
  }
];

export async function getStaticPaths() {
  return SUPPORTED_LANGS.map(lang => ({
    params: { lang },
    props: { locale: lang }
  }));
}

const { lang } = Astro.params;
const locale = SUPPORTED_LANGS.includes(lang) ? lang : DEFAULT_LANG;
const t = translations[locale] || translations.fr;

// Ensure all sections have fallbacks to French
const hero = t.hero || translations.fr.hero;
const bandeau = t.bandeau || translations.fr.bandeau;
const booksTrans = t.books || translations.fr.books;
const newsletter = t.newsletter || translations.fr.newsletter;
const faq = t.faq || translations.fr.faq;
const cta = t.cta || translations.fr.cta;
const footer = t.footer || translations.fr.footer;

// Get translated book data for this locale (with fallback to French)
const bookData = t.bookData || translations.fr.bookData || {};

const canonicalURL = `https://kikienchrist.vercel.app/${locale}/`;

const heroEyebrow = hero?.eyebrow || "Nouveauté";
const heroTitle = hero?.title || "Kiki en Christ";

// Hero subtitle hardcodé par langue (bypass JSON cache Vercel)
const heroSubtitles: Record<string, string> = {
  fr: "Quatre ouvrages indépendants. Papier, ebook et audio. Disponibles en 9 langues.",
  en: "Four independent books. Paper, ebook and audio. Available in 9 languages.",
  es: "Cuatro libros independientes. Papel, ebook y audio. Disponibles en 9 idiomas.",
  pt: "Quatro livros independentes. Papel, ebook e áudio. Disponíveis em 9 idiomas.",
  it: "Quattro libri indipendenti. Carta, ebook e audio. Disponibili in 9 lingue.",
  de: "Vier unabhängige Bücher. Taschenbuch, E-Book und Hörbuch. In 9 Sprachen verfügbar.",
  nl: "Vier onafhankelijke boeken. Paperback, ebook en audio. Beschikbaar in 9 talen.",
  pl: "Cztery niezależne książki. Papier, ebook i audio. Dostępne w 9 językach.",
  ar: "أربعة كتب مستقلة. ورقي، كتاب إلكتروني، وصوتي. متاح بـ 9 لغات.",
  ru: "Четыре независимые книги. Бумага, электронная книга и аудио. Доступны на 9 языках.",
  zh: "四本独立著作。平装、电子书和有声书。提供 9 种语言版本。",
  hi: "चार स्वतंत्र पुस्तकें। पेपरबैक, ईबुक और ऑडियो। 9 भाषाओं में उपलब्ध।",
};
const heroSubtitle = heroSubtitles[locale] || heroSubtitles.fr;

const heroCtaText = hero?.ctaText || "Découvrir les livres";
const heroCtaHref = `/${locale}/livres`;
const heroSecondaryCtaText = hero?.secondaryCtaText || "Rejoindre la newsletter";
const heroSecondaryCtaHref = `/${locale}/contact`;

const bandeauPaper = bandeau?.paper || "Papier — Lulu";
const bandeauEbook = bandeau?.ebook || "Ebook — Payhip";
const bandeauAudio = bandeau?.audio || "Audio — Google Play";

const faqItems = faq?.items || [
  { question: "Pourquoi ces livres ?", answer: "Pour aider chacun à prier et méditer, où qu'il soit." },
  { question: "Quels formats ?", answer: "Papier (Lulu), Ebook (Payhip), Audio (Google Play)." },
  { question: "Garantie ?", answer: "Satisfait ou remboursé 30 jours." },
];

const ctaText = cta?.text || "Prêt à commencer votre chemin ? Choisissez le livre qui résonne — le premier pas change tout.";
const ctaButtonText = cta?.buttonText || "Voir les 4 livres";
const ctaButtonHref = `/${locale}/livres`;

// Images et alt texts pour l'éventail Hero (ordre = visage, trinite, combat, salut)
const heroFanImages = [
  "/images/books/visage-fr.jpg",
  "/images/books/trinite-fr.png",
  "/images/books/combat-fr.jpg",
  "/images/books/salut-fr.jpg"
];

const heroFanAlts = [
  "Le visage de Dieu : la quête de la spiritualité et de la transcendance",
  "Les secrets de la Trinité enfin dévoilés",
  "Le dernier Combat : garder la Foi",
  "Le mystère du Salut"
];
---

<MainLayout lang={locale} title={t.home?.title || 'Kiki en Christ'} description={t.home?.description || 'Livres de prière et méditation chrétienne'} canonicalURL={canonicalURL} currentPath={`/${locale}/`}>
  <Hero
    eyebrow={heroEyebrow}
    title={heroTitle}
    subtitle={heroSubtitle}
    ctaText={heroCtaText}
    ctaHref={heroCtaHref}
    fanImages={heroFanImages}
    fanAltTexts={heroFanAlts}
  />

  <section class="bq-books-section" aria-labelledby="books-title">
    <div class="bq-container">
      <h2 id="books-title" class="bq-section-title">{booksTrans?.title || 'Nos livres'}</h2>
      <p class="bq-section-intro">{booksTrans?.subtitle || 'Quatre livres pour approfondir votre vie de prière'}</p>

      <div class="bq-books-grid">
        {books.map((book, i) => {
          const langBook = bookData[book.id] || bookData[Object.keys(bookData)[0]] || {};
          return (
            <BookCard
              book={book}
              isEven={i % 2 === 1}
              seriesPrefix={booksTrans?.seriesPrefix || 'Livre'}
              hook={langBook.hook || bookData.visage?.hook || "Un livre pour ceux qui cherchent Dieu au-delà des dogmes."}
              benefits={langBook.benefits || booksTrans?.benefits || [
                "Une foi personnelle, sans intermédiaire",
                "Accessible à tous, où que vous soyez",
                "Garantie satisfait ou remboursé 30 jours"
              ]}
              metaSuffix={langBook.metaSuffix || 'pages'}
              languagesLabel={langBook.languagesLabel || 'Langues disponibles'}
              languages={langBook.languages || [
                { code: 'fr', name: 'Français', fmt: '' },
                { code: 'en', name: 'English', fmt: '' },
                { code: 'es', name: 'Español', fmt: '' },
                { code: 'pt', name: 'Português', fmt: '' },
                { code: 'it', name: 'Italiano', fmt: '' },
                { code: 'de', name: 'Deutsch', fmt: '' },
                { code: 'nl', name: 'Nederlands', fmt: '' },
                { code: 'pl', name: 'Polski', fmt: '' },
                { code: 'ar', name: 'العربية', fmt: '' },
                { code: 'ru', name: 'Русский', fmt: '' },
                { code: 'zh', name: '中文', fmt: '' },
                { code: 'hi', name: 'हिन्दी', fmt: '' },
              ]}
              currentPageLang={locale}
            />
          );
        })}
      </div>

      <Newsletter
        title={newsletter?.title || 'Rejoignez la newsletter'}
        subtitle={newsletter?.subtitle || 'Une méditation par semaine, directement dans votre boîte mail'}
        buttonText={newsletter?.buttonText || "S'abonner"}
        placeholder={newsletter?.placeholder || 'votre@email.com'}
        availability={footer?.availability || 'Livres disponibles en papier, ebook et audio.'}
      />

      <FAQ
        title={faq?.title || 'Questions fréquentes'}
        items={faqItems}
      />

      <CTAStrip
        text={ctaText}
        buttonText={ctaButtonText}
        buttonHref={ctaButtonHref}
      />
    </div>
  </section>
</MainLayout>

<style is:global>
  .bq-books-section { padding: var(--space-3xl) 0; }
  .bq-section-intro { text-align: center; color: var(--muted); font-size: var(--text-lg); font-family: Georgia, serif; max-width: 700px; margin: 0 auto var(--space-2xl); }
  <bq-books-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-xl); margin-bottom: var(--space-2xl); }</bq-books-grid>
</style>