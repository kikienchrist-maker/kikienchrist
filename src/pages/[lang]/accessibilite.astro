---
// Accessibilité - Route dynamique multilingue
import { getCollection } from 'astro:content';
import LegalLayout from '../../components/LegalLayout.astro';

export async function getStaticPaths() {
  const allPages = await getCollection('legalPages');
  // getCollection returns entries with .data directly (not .entry.data)
  const pages = allPages.filter(p => p.data.pageSlug === 'accessibilite');
  
  return pages.map(page => ({
    params: { lang: page.data.lang },
    props: { page },
  }));
}

const { page } = Astro.props;
const { title, description, pageSlug, lang, lastUpdated } = page.data;
const content = page.body; // Astro type:'content' injecte le body Markdown dans .body
const version = '1.0';
---

<LegalLayout
  title={title}
  description={description}
  slug={pageSlug}
  lang={lang}
  lastUpdated={lastUpdated}
  version={version}
  content={content}
/>