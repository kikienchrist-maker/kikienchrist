---
// [lang]/blog/[page].astro - Page d'accueil blog avec pagination native Astro
import { getCollection } from 'astro:content';
import { paginate } from 'astro:paginate';
import BlogIndex from '@components/blog/BlogIndex.astro';
import type { CollectionEntry } from 'astro:content';

const validLangs = ['fr', 'en', 'es', 'pt', 'it', 'de', 'nl', 'pl', 'ar'];

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  
  // Grouper par langue
  const postsByLang: Record<string, CollectionEntry<'blog'>[]> = {};
  for (const post of posts) {
    if (!postsByLang[post.data.lang]) {
      postsByLang[post.data.lang] = [];
    }
    postsByLang[post.data.lang].push(post);
  }
  
  const paths = [];
  
  for (const [lang, langPosts] of Object.entries(postsByLang)) {
    // Trier par date décroissante
    langPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
    
    // Pagination
    const paginated = paginate(langPosts, { 
      pageSize: 10,
      params: { lang },
    });
    
    for (const page of paginated) {
      paths.push({
        params: { lang, ...page.params },
        props: { 
          posts: page.data,
          pagination: page.pagination,
          lang,
        },
      });
    }
  }
  
  return paths;
}

const { posts, pagination, lang } = Astro.props;

if (!validLangs.includes(lang)) {
  return Astro.redirect('/fr/blog/');
}
---

<BlogIndex 
  lang={lang} 
  posts={posts as CollectionEntry<'blog'>[]} 
  pagination={pagination}
/>