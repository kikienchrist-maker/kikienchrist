---
// [lang]/blog/categorie/[category]/[page].astro - Page catégorie avec pagination (slugifiée)
import { getCollection } from 'astro:content';
import { paginate } from 'astro:paginate';
import BlogIndex from '@components/blog/BlogIndex.astro';
import type { CollectionEntry } from 'astro:content';

const validCategories = ['prière', 'formation', 'témoignage', 'vie-chrétienne', 'famille', 'mission', 'actualité', 'ressource'];
const validLangs = ['fr', 'en', 'es', 'pt', 'it', 'de', 'nl', 'pl', 'ar'];

// Slugifier : accents → ascii, espaces → tirets, minuscules (déclarée au niveau module pour getStaticPaths)
function slugify(str: string): string {
  return str
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '') // enlever accents
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-') // non-alphanum → tiret
    .replace(/(^-|-$)/g, ''); // trim tirets
}

// Map slug → catégorie originale
const categorySlugMap: Record<string, string> = {};
for (const cat of validCategories) {
  categorySlugMap[slugify(cat)] = cat;
}

export async function getStaticPaths({ paginate }) {
  const validCategoriesLocal = ['prière', 'formation', 'témoignage', 'vie-chrétienne', 'famille', 'mission', 'actualité', 'ressource'];
  const validLangsLocal = ['fr', 'en', 'es', 'pt', 'it', 'de', 'nl', 'pl', 'ar'];
  
  // Slugifier locale pour getStaticPaths
  function slugifyLocal(str: string): string {
    return str
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  }
  
  const posts = await getCollection('blog', ({ data }) => 
    !data.draft && validCategoriesLocal.includes(data.category)
  );
  
  // Grouper par langue + catégorie
  const postsByLangCat: Record<string, Record<string, CollectionEntry<'blog'>[]>> = {};
  
  for (const post of posts) {
    const lang = post.data.lang;
    const cat = post.data.category;
    
    if (!postsByLangCat[lang]) postsByLangCat[lang] = {};
    if (!postsByLangCat[lang][cat]) postsByLangCat[lang][cat] = [];
    
    postsByLangCat[lang][cat].push(post);
  }
  
  const paths = [];
  
  for (const [lang, cats] of Object.entries(postsByLangCat)) {
    if (!validLangsLocal.includes(lang)) continue;
    
    for (const [cat, catPosts] of Object.entries(cats)) {
      catPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
      
      const catSlug = slugifyLocal(cat);
      const paginated = paginate(catPosts, { 
        pageSize: 10,
        params: { lang, category: catSlug }, // URL utilise le slug
      });
      
      for (const page of paginated) {
        paths.push({
          params: { lang, category: catSlug, ...page.params }, // param slug
          props: { 
            posts: page.data,
            pagination: page.pagination,
            lang,
            category: cat, // prop catégorie originale pour affichage
          },
        });
      }
    }
  }
  
  return paths;
}

const { posts, pagination, lang, category } = Astro.props;

// Résoudre slug → catégorie originale
const resolvedCategory = categorySlugMap[category] || category;

if (!validLangs.includes(lang) || !validCategories.includes(resolvedCategory)) {
  return Astro.redirect('/fr/blog/');
}
---

<BlogIndex 
  lang={lang} 
  category={resolvedCategory}
  posts={posts as CollectionEntry<'blog'>[]} 
  pagination={pagination}
/>