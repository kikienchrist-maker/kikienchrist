---
// src/pages/[lang]/livres.astro
import MainLayout from '../../layouts/MainLayout.astro';
import type { Lang } from '../../data/translations.json';
import fs from 'fs';
import path from 'path';

const translations = JSON.parse(fs.readFileSync(path.resolve('./src/data/translations.json'), 'utf-8'));

export async function getStaticPaths() {
  const langs = ['fr', 'en', 'es', 'pt', 'de', 'it', 'nl', 'pl', 'ar', 'ru', 'zh', 'hi'] as const;
  return langs.map(lang => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const t = translations[lang] || translations.fr;
const books = translations.booksData?.[lang] || translations.booksData?.fr || [];

const pageTitle = t.books?.title || 'Nos Livres';
const pageDescription = t.books?.description || `Découvrez nos ${books.length} livres chrétiens pour grandir dans la foi. E-books et versions papier disponibles.`;
const canonicalURL = `https://kikienchrist.vercel.app/${lang}/livres/`;
const ogImage = `https://kikienchrist.vercel.app/og/books-${lang}.jpg`;

// Schema.org Book + ItemList
const bookSchemas = books.map(book => ({
  '@type': 'Book',
  name: book.title,
  author: { '@type': 'Person', name: 'Kiki' },
  isbn: book.isbn,
  numberOfPages: book.pages,
  publisher: { '@type': 'Organization', name: 'Kiki en Christ' },
  datePublished: book.publishedDate,
  inLanguage: lang,
  offers: {
    '@type': 'Offer',
    price: book.price,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: book.buyUrl,
  },
  description: book.description,
}));

const jsonLd = {
  '@type': 'ItemList',
  itemListElement: books.map((book, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: bookSchemas[i],
  })),
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  ogImage={ogImage}
  lang={lang}
  currentPath="/livres/"
  jsonLd={jsonLd}
>
  <section class="bq-books-page" aria-labelledby="books-title">
    <header class="bq-page-header">
      <h1 id="books-title" class="bq-page-title">{pageTitle}</h1>
      <p class="bq-page-subtitle">{t.books?.subtitle || 'Des livres pour nourrir votre foi et approfondir votre relation avec Dieu'}</p>
    </header>

    <div class="bq-books-grid" role="list">
      {books.map(book => (
        <article class="bq-book-card" role="listitem" itemscope itemtype="https://schema.org/Book">
          <div class="bq-book-cover">
            <picture>
              <source srcset={book.coverImage.replace('400w', '800w')} type="image/webp" media="(min-width: 600px)">
              <img src={book.coverImage} alt={book.title} loading="lazy" width="300" height="450" itemprop="image">
            </picture>
            <span class="bq-book-badge">{book.badge || t.books?.badge || 'Bestseller'}</span>
          </div>
          
          <div class="bq-book-info">
            <h2 class="bq-book-title" itemprop="name">{book.title}</h2>
            <p class="bq-book-subtitle" itemprop="description">{book.description}</p>
            
            <div class="bq-book-meta">
              <span itemprop="numberOfPages">{book.pages} pages</span>
              <span itemprop="isbn">ISBN {book.isbn}</span>
            </div>

            <ul class="bq-book-benefits">
              {book.benefits?.map(b => <li class="bq-benefit"><svg class="bq-check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 10l3 3 7-7"/></svg>{b}</li>)}
            </ul>

            <div class="bq-book-price">
              <span class="bq-price">{book.price} €</span>
              <a href={book.buyUrl} target="_blank" rel="noopener noreferrer" class="bq-btn bq-btn-primary bq-btn-full" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                Acheter
                <meta itemprop="price" content={book.price} />
                <meta itemprop="priceCurrency" content="EUR" />
                <link itemprop="availability" href="https://schema.org/InStock" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="bq-books-rich-content">
      <h2 class="bq-section-title">Pourquoi choisir nos livres ?</h2>
      <div class="bq-rich-grid">
        <article class="bq-rich-card">
          <div class="bq-rich-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3>Approche accessible</h3>
          <p>Théologie profonde mais langage simple, pour tous les chrétiens.</p>
        </article>
        <article class="bq-rich-card">
          <div class="bq-rich-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2"/>
              <path d="M8 21h8"/>
              <path d="M12 17v4"/>
            </svg>
          </div>
          <h3>Formats multiples</h3>
          <p>Papier, ebook (PDF/ePub), audio — lisez comme vous voulez.</p>
        </article>
        <article class="bq-rich-card">
          <div class="bq-rich-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <h3>Garantie 30 jours</h3>
          <p>Satisfait ou remboursé — aucun risque pour vous.</p>
        </article>
      </div>
    </div>

    <section class="bq-books-faq" aria-labelledby="books-faq-title">
      <h2 id="books-faq-title" class="bq-section-title">Questions fréquentes</h2>
      <div class="bq-faq" id="faq">
        <details class="bq-faq-item">
          <summary class="bq-faq-question">Comment télécharger mon ebook après achat ?</summary>
          <div class="bq-faq-answer">
            <p>Un lien de téléchargement immédiat vous est envoyé par email. Accessible aussi depuis votre compte Payhip/Lulu.</p>
          </div>
        </details>
        <details class="bq-faq-item">
          <summary class="bq-faq-question">Les livres sont-ils disponibles dans ma langue ?</summary>
          <div class="bq-faq-answer">
            <p>Nos 4 livres sont traduits en 11 langues : français, anglais, espagnol, portugais, italien, allemand, néerlandais, polonais, arabe, russe, chinois, hindi.</p>
          </div>
        </details>
        <details class="bq-faq-item">
          <summary class="bq-faq-question">Quelle est la politique de remboursement ?</summary>
          <div class="bq-faq-answer">
            <p>Garantie satisfait ou remboursé 30 jours. Contactez-nous à kikienchrist@gmail.com.</p>
          </div>
        </details>
      </div>
    </section>

    <section class="bq-books-testimonials" aria-labelledby="testimonials-title">
      <h2 id="testimonials-title" class="bq-section-title">Ce qu'en disent nos lecteurs</h2>
      <div class="bq-testimonials-grid">
        {[
          { text: "\"Le Visage de Dieu a transformé ma vie de prière. Enfin un livre qui parle au cœur sans jargon.\"", author: "Marie, 42 ans" },
          { text: "\"Les secrets de la Trinité : une révélation. Clair, biblique, profond. À mettre entre toutes les mains.\"", author: "Pierre, 35 ans" },
          { text: "\"Le dernier Combat m'a porté dans l'épreuve. Une lecture qui renforce la foi jour après jour.\"", author: "Sophie, 28 ans" },
          { text: "\"Le mystère du Salut : théologie solide, cœur pastoral. Un trésor pour la méditation quotidienne.\"", author: "Thomas, 51 ans" },
        ].map(t => (
          <article class="bq-testimonial">
            <div class="bq-testimonial-stars" aria-label="5 étoiles">★★★★★</div>
            <p class="bq-testimonial-text">{t.text}</p>
            <footer class="bq-testimonial-author">— {t.author}</footer>
          </article>
        ))}
      </div>
    </section>
  </section>
</MainLayout>

<style is:global>
  .bq-books-page { max-width: 1140px; margin: 0 auto; padding: var(--space-2xl) var(--space-md); }
  .bq-page-header { text-align: center; margin-bottom: var(--space-2xl); }
  .bq-page-title { font-family: Georgia, serif; font-size: clamp(28px, 4vw, 44px); font-weight: 400; color: var(--ink); margin: 0 0 var(--space-md); }
  .bq-page-subtitle { color: var(--muted); font-size: var(--text-lg); font-family: Georgia, serif; margin: 0; max-width: 700px; margin-left: auto; margin-right: auto; }
  .bq-books-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-xl); margin-bottom: var(--space-3xl); }
  .bq-book-card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column; transition: all var(--transition-normal); }
  .bq-book-card:hover { border-color: var(--gold); box-shadow: var(--shadow-lg); transform: translateY(-4px); }
  .bq-book-cover { position: relative; aspect-ratio: 2/3; overflow: hidden; }
  .bq-book-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-slow); }
  .bq-book-card:hover .bq-book-cover img { transform: scale(1.05); }
  .bq-book-badge { position: absolute; top: var(--space-sm); left: var(--space-sm); background: var(--gold); color: var(--ink); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  .bq-book-info { display: flex; flex-direction: column; flex: 1; padding: var(--space-md); }
  .bq-book-title { font-family: Georgia, serif; font-size: var(--text-lg); font-weight: 400; line-height: 1.3; color: var(--ink); margin: 0 0 var(--space-xs); }
  .bq-book-subtitle { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; margin: 0 0 var(--space-md); flex: 1; }
  .bq-book-meta { display: flex; flex-wrap: wrap; gap: var(--space-md); font-size: var(--text-xs); color: var(--muted); margin-bottom: var(--space-md); padding-bottom: var(--space-md); border-bottom: 1px solid var(--line); }
  .bq-book-benefits { list-style: none; margin: 0 0 var(--space-md); padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .bq-benefit { display: flex; align-items: flex-start; gap: var(--space-sm); font-size: var(--text-sm); color: var(--muted); }
  .bq-check { width: 16px; height: 16px; flex-shrink: 0; color: var(--gold); margin-top: 2px; }
  .bq-book-price { display: flex; flex-direction: column; gap: var(--space-sm); margin-top: auto; }
  .bq-price { font-size: var(--text-xl); font-weight: 700; color: var(--ink); font-family: Georgia, serif; }
  .bq-books-rich-content { border-top: 1px solid var(--line); padding-top: var(--space-2xl); margin-bottom: var(--space-3xl); }
  .bq-rich-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-xl); margin-top: var(--space-xl); }
  .bq-rich-card { text-align: center; padding: var(--space-lg); background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); transition: all var(--transition-normal); }
  .bq-rich-card:hover { border-color: var(--gold); box-shadow: var(--shadow-md); }
  .bq-rich-icon { width: 64px; height: 64px; margin: 0 auto var(--space-md); display: flex; align-items: center; justify-content: center; background: var(--gold-soft); border-radius: 50%; color: var(--gold-ink); }
  .bq-rich-icon svg { width: 32px; height: 32px; }
  .bq-rich-card h3 { font-family: Georgia, serif; font-size: var(--text-lg); font-weight: 400; color: var(--ink); margin: 0 0 var(--space-sm); }
  .bq-rich-card p { color: var(--muted); font-size: var(--text-sm); margin: 0; }
  .bq-books-faq { margin-bottom: var(--space-3xl); }
  .bq-faq { display: flex; flex-direction: column; gap: 0; }
  .bq-faq-item { border-bottom: 1px solid var(--line); }
  .bq-faq-item:first-of-type { border-top: 1px solid var(--line); border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  .bq-faq-item:last-of-type { border-bottom: none; border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
  .bq-faq-question { font: 600 16.5px/1.45 Georgia, serif; padding: 20px 0; color: var(--ink); list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 18px; cursor: pointer; }
  .bq-faq-question::-webkit-details-marker { display: none; }
  .bq-faq-question::after { content: "+"; flex: 0 0 auto; font: 400 21px/1 system-ui, sans-serif; color: var(--gold-ink); transition: transform var(--transition-fast); }
  .bq-faq-item[open] .bq-faq-question::after { content: "−"; transform: rotate(180deg); }
  .bq-faq-answer { padding: 0 0 20px; }
  .bq-faq-answer p { margin: 0; color: var(--muted); }
  .bq-books-testimonials { }
  .bq-testimonials-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-xl); margin-top: var(--space-xl); }
  .bq-testimonial { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: var(--space-lg); transition: all var(--transition-normal); }
  .bq-testimonial:hover { border-color: var(--gold); box-shadow: var(--shadow-md); }
  .bq-testimonial-stars { color: var(--gold); font-size: var(--text-lg); margin-bottom: var(--space-md); }
  .bq-testimonial-text { font-style: italic; color: var(--ink); margin: 0 0 var(--space-md); font-size: var(--text-base); line-height: 1.6; }
  .bq-testimonial-author { color: var(--muted); font-size: var(--text-sm); font-weight: 500; }
</style>