---
import '../styles/lafoidieu-design.css';
import type { AstroGlobal } from 'astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import CookieConsent from '../components/CookieConsent.astro';

// Import translations directly to avoid import issues
import * as fs from 'fs';
import * as path from 'path';

const translationsPath = path.resolve('./src/data/translations.json');
const translations = JSON.parse(fs.readFileSync(translationsPath, 'utf-8'));

interface MainLayoutProps {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  lang: string;
  currentPath?: string;
  jsonLd?: object | object[];
  noIndex?: boolean;
  children?: any;
}

const {
  title,
  description,
  canonicalURL,
  ogImage,
  lang,
  currentPath = '/',
  jsonLd,
  noIndex = false,
  ...rest
} = Astro.props as MainLayoutProps;

const t = translations[lang] || translations.fr;
const siteName = 'Kiki en Christ';
const baseUrl = 'https://kikienchrist.vercel.app';

// ─── AUTO TITLE ───
const pageTitle = title 
  ? (title === siteName ? siteName : `${title} | ${siteName}`)
  : (t.home?.title === siteName ? siteName : `${t.home?.title || siteName} | ${siteName}`);

// ─── AUTO DESCRIPTION ───
const pageDescription = description 
  ? description 
  : (t.home?.description || 'Kiki en Christ - Livre de prière et méditation chrétienne');

// ─── AUTO CANONICAL ───
const pageCanonical = canonicalURL 
  ? canonicalURL 
  : `${baseUrl}${currentPath}`;

// ─── AUTO OG IMAGE ───
const pageOgImage = ogImage 
  ? ogImage 
  : `${baseUrl}/og/default.png`;

// ─── AUTO JSON-LD (WebSite + Organization + Breadcrumb) ───
const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: baseUrl,
  inLanguage: lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${baseUrl}/${lang}/search?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
  publisher: {
    '@type': 'Organization',
    name: siteName,
    logo: {
      '@type': 'ImageObject',
      url: `${baseUrl}/logo.png`,
    },
    sameAs: [
      'https://www.facebook.com/kikienchrist',
      'https://www.instagram.com/kikienchrist',
      'https://twitter.com/kikienchrist',
      'https://www.youtube.com/@kikienchrist',
    ],
  },
};

// Ensure currentPath is a string
const safeCurrentPath = typeof currentPath === 'string' ? currentPath : '/';

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav?.home || 'Accueil', item: `${baseUrl}/${lang}/` },
    ...(safeCurrentPath && safeCurrentPath !== '/' 
      ? safeCurrentPath.split('/')
          .filter((s): s is string => typeof s === 'string' && s.length > 0)
          .map((seg, i) => {
            const cleanSeg = String(seg).trim();
            if (!cleanSeg || cleanSeg.length === 0) {
              return undefined;
            }
            const firstChar = cleanSeg.charAt(0);
            if (!firstChar || firstChar.length === 0) {
              return undefined;
            }
            const name = firstChar.toUpperCase() + cleanSeg.slice(1).replace(/-/g, ' ');
            if (!name || name.length === 0) {
              return undefined;
            }
            return {
              '@type': 'ListItem',
              position: i + 2,
              name: name,
              item: `${baseUrl}/${lang}/${safeCurrentPath.split('/').slice(0, i+1).join('/')}/`,
            };
          }).filter((item): item is { '@type': 'ListItem'; position: number; name: string; item: string } => 
            item !== undefined && 
            item !== null && 
            typeof item.name === 'string' && 
            item.name.length > 0 && 
            typeof item.item === 'string' && 
            item.item.length > 0 && 
            typeof item.position === 'number' && 
            item.position > 0
          )
      : []),
  ],
};

const finalSchema = jsonLd 
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        baseSchema,
        ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]),
        breadcrumbSchema
      ]
    }
  : {
      '@context': 'https://schema.org',
      '@graph': [
        baseSchema,
        breadcrumbSchema
      ]
    };

const canonicalUrl = new URL(pageCanonical);
const alternateLangs = ['fr', 'en', 'es', 'pt', 'de', 'it', 'nl', 'pl', 'ar', 'ru', 'zh', 'hi']
  .reduce((acc, l) => {
    acc[l] = `${baseUrl}/${l}${currentPath}`;
    return acc;
  }, {} as Record<string, string>);
alternateLangs['x-default'] = `${baseUrl}/fr${currentPath}`;
---

<!DOCTYPE html>
<html lang={lang} dir={['ar', 'he'].includes(lang) ? 'rtl' : 'ltr'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  {/* ─── TITLE & META ─── */}
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href={pageCanonical} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  
  {/* ─── HREFLANG ─── */}
  {Object.entries(alternateLangs).map(([hreflang, href]) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
  ))}
  
  {/* ─── OPEN GRAPH ─── */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={pageCanonical} />
  <meta property="og:image" content={pageOgImage} />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : lang === 'en' ? 'en_US' : lang === 'es' ? 'es_ES' : lang === 'pt' ? 'pt_PT' : lang === 'de' ? 'de_DE' : lang === 'it' ? 'it_IT' : lang === 'nl' ? 'nl_NL' : lang === 'pl' ? 'pl_PL' : lang === 'ar' ? 'ar_SA' : lang === 'ru' ? 'ru_RU' : lang === 'zh' ? 'zh_CN' : 'hi_IN'} />
  
  {/* ─── TWITTER CARD ─── */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@kikienchrist" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={pageOgImage} />
  
  {/* ─── JSON-LD SCHEMA.ORG ─── */}
  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
  
  {/* ─── STYLES ─── */}
  <link rel="stylesheet" href="/styles/lafoidieu-design.css" />
  
  {/* ─── FAVICON ─── */}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  
  {/* ─── RSS ─── */}
  <link rel="alternate" type="application/rss+xml" title="Kiki en Christ - Blog" href="/fr/blog/rss.xml" />
  
  {Astro.slots.has('head') && <slot name="head" />}
</head>
<body class="bq">
  <a href="#main-content" class="bq-skip-link">Aller au contenu principal</a>
  
  <header class="bq-header" role="banner">
    <div class="bq-container">
      <div class="bq-header-inner">
        <a href={`/${lang}/`} class="bq-logo" aria-label={t.nav?.home || 'Accueil'}>
          <img src="/favicon.png" alt="" class="bq-logo-icon" width="32" height="32" aria-hidden="true" />
          <span class="bq-logo-text">Kiki en Christ</span>
        </a>
        
        <nav class="bq-nav" role="navigation" aria-label={t.nav?.main || 'Navigation principale'}>
          <ul class="bq-nav-list">
            <li><a href={`/${lang}/`} class="bq-nav-link">{t.nav?.home || 'Accueil'}</a></li>
            <li><a href={`/${lang}/livres`} class="bq-nav-link">{t.nav?.books || 'Livres'}</a></li>
            <li><a href={`/${lang}/partenaires`} class="bq-nav-link">{t.nav?.partners || 'Partenaires'}</a></li>
            <li><a href={`/${lang}/contact`} class="bq-nav-link">{t.nav?.contact || 'Contact'}</a></li>
          </ul>
        </nav>
        
        <div class="bq-header-actions">
          <LanguageSwitcher currentLang={lang} currentPath={currentPath} />
        </div>
      </div>
    </div>
  </header>
  
  <main id="main-content" class="bq-main" role="main" {...rest}>
    <slot />
  </main>
  
  <footer class="bq-footer" role="contentinfo">
    <div class="bq-container">
      <div class="bq-footer-grid">
        <div class="bq-footer-brand">
          <a href={`/${lang}/`} class="bq-footer-logo">
            <img src="/favicon.png" alt="" class="bq-logo-icon" width="32" height="32" aria-hidden="true" />
            <span>Kiki en Christ</span>
          </a>
          <p class="bq-footer-tagline">{t.footer?.tagline || 'Priez, méditez, grandissez dans la foi'}</p>
        </div>
        
        <nav class="bq-footer-nav" aria-label={t.footer?.navigation || 'Navigation'}>
          <h3 class="bq-footer-title">{t.footer?.siteLinks || 'Le site'}</h3>
          <ul class="bq-footer-list">
            <li><a href={`/${lang}/`} class="bq-footer-link">{t.nav?.home || 'Accueil'}</a></li>
            <li><a href={`/${lang}/livres`} class="bq-footer-link">{t.nav?.books || 'Nos livres'}</a></li>
            <li><a href={`/${lang}/partenaires`} class="bq-footer-link">{t.nav?.partners || 'Partenaires'}</a></li>
            <li><a href={`/${lang}/contact`} class="bq-footer-link">{t.nav?.contact || 'Contact'}</a></li>
          </ul>
        </nav>
        
        <nav class="bq-footer-nav" aria-label={t.footer?.legal || 'Mentions légales'}>
          <h3 class="bq-footer-title">{t.footer?.legal || 'Mentions légales'}</h3>
          <ul class="bq-footer-list">
            <li><a href={`/${lang}/mentions-legales`} class="bq-footer-link">{t.footer?.mentionsLegales || 'Mentions légales'}</a></li>
            <li><a href={`/${lang}/confidentialite`} class="bq-footer-link">{t.footer?.privacy || 'Confidentialité'}</a></li>
            <li><a href={`/${lang}/cookies`} class="bq-footer-link">{t.footer?.cookies || 'Cookies'}</a></li>
            <li><a href={`/${lang}/cgv`} class="bq-footer-link">{t.footer?.cgv || 'CGV'}</a></li>
            <li><a href={`/${lang}/accessibilite`} class="bq-footer-link">{t.footer?.accessibility || 'Accessibilité'}</a></li>
          </ul>
        </nav>
        
        <div class="bq-footer-social">
          <h3 class="bq-footer-title">{t.footer?.followUs || 'Suivez-nous'}</h3>
          <div class="bq-social-links">
            <a href="https://www.facebook.com/kikienchrist" class="bq-social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://www.instagram.com/kikienchrist" class="bq-social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="https://twitter.com/kikienchrist" class="bq-social-link" aria-label="Twitter" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
            </a>
            <a href="https://www.youtube.com/@kikienchrist" class="bq-social-link" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          </div>
        </div>
      </div>
      
      <div class="bq-footer-bottom">
        <p class="bq-copyright">© {new Date().getFullYear()} Kiki en Christ. {t.footer?.allRights || 'Tous droits réservés.'}</p>
      </div>
    </div>
  </footer>
  
  <slot name="scripts" />

  <!-- Bannière RGPD (Cookie Consent) -->
  <CookieConsent />

</body>
</html>