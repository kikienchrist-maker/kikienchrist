{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:astro/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "astro"],
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    ".astro/",
    "skills/",
    "scripts/",
    "tests/",
    "playwright-report/",
    "test-results/",
    "*.config.*",
    "*.d.ts",
    "lighthouserc.json",
    "*.cjs",
    "src/content/legalPages/",
    "src/data/",
    "netlify/functions/",
    "docs/",
    "audit-seo/"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "astro/no-unused-define-vars": "warn"
  },
  "overrides": [
    {
      "files": ["*.astro"],
      "parser": "astro-eslint-parser",
      "parserOptions": {
        "parser": "@typescript-eslint/parser",
        "extraFileExtensions": [".astro"]
      }
    }
  ]
}
