{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "budgets": [
          { "resourceType": "total", "budget": 1500, "unit": "kb" },
          { "resourceType": "script", "budget": 100, "unit": "kb" },
          { "resourceType": "css", "budget": 60, "unit": "kb" },
          { "resourceType": "image", "budget": 500, "unit": "kb" },
          { "resourceType": "font", "budget": 100, "unit": "kb" },
          { "resourceType": "third-party", "budget": 50, "unit": "kb" }
        ],
        "assert": {
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2200 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "interaction-to-next-paint": ["error", { "maxNumericValue": 150 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
            "color-contrast": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "label": ["error", { "minScore": 1 }],
            "html-has-lang": ["error", { "minScore": 1 }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-viewport": ["error", { "minScore": 1 }],
            "structured-data": ["warn", { "minScore": 1 }]
          }
        }
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}